{
    "datasets": {
        "customer_olap": {
            "name": "customer_olap",
            "display_name": "Customer OLAP Analytics",
            "description": "Comprehensive customer analytics with orders, products, revenue, and behavior analysis. Supports multi-dimensional queries on customer segments, regions, products, and time periods.",
            "source_table": "read_csv_auto('${data.duckdb.dir}/customers.csv') AS customers",
            "joins": [
                {
                    "table": "read_csv_auto('${data.duckdb.dir}/orders.csv')",
                    "type": "LEFT",
                    "on": "customers.customer_id = orders.customer_id",
                    "alias": "orders"
                },
                {
                    "table": "read_csv_auto('${data.duckdb.dir}/products.csv')",
                    "type": "LEFT",
                    "on": "orders.product_name = products.product_name",
                    "alias": "products"
                }
            ],
            "dimensions": [
                {
                    "name": "customer_segment",
                    "column": "customer_segment",
                    "description": "Customer business segment (Consumer, Enterprise, Small Business, Government)"
                },
                {
                    "name": "customer_tier",
                    "column": "customer_tier",
                    "description": "Customer loyalty tier (Bronze, Silver, Gold, Platinum)"
                },
                {
                    "name": "region",
                    "column": "region",
                    "description": "Geographic region (North, South, East, West, Central)"
                },
                {
                    "name": "country",
                    "column": "country",
                    "description": "Customer country"
                },
                {
                    "name": "acquisition_channel",
                    "column": "acquisition_channel",
                    "description": "How customer was acquired (Organic, Paid Ads, Referral, Social Media)"
                },
                {
                    "name": "age_group",
                    "column": "age_group",
                    "description": "Customer age group"
                },
                {
                    "name": "product_category",
                    "column": "product_category",
                    "description": "Product category (Electronics, Furniture, Clothing, Food, Office Supplies)"
                },
                {
                    "name": "product_name",
                    "column": "product_name",
                    "description": "Specific product name"
                },
                {
                    "name": "order_date",
                    "column": "order_date",
                    "type": "time",
                    "description": "Order date for time-based analysis"
                },
                {
                    "name": "payment_method",
                    "column": "payment_method",
                    "description": "Payment method used"
                },
                {
                    "name": "sales_rep",
                    "column": "sales_rep",
                    "description": "Sales representative"
                },
                {
                    "name": "signup_date",
                    "column": "signup_date",
                    "type": "time",
                    "description": "Customer signup date for cohort analysis"
                }
            ],
            "measures": [
                {
                    "name": "order_count",
                    "expression": "COUNT(DISTINCT order_id)",
                    "description": "Total number of orders"
                },
                {
                    "name": "customer_count",
                    "expression": "COUNT(DISTINCT customer_id)",
                    "description": "Total number of unique customers"
                },
                {
                    "name": "total_revenue",
                    "expression": "SUM(quantity * unit_price * (1 - discount_pct/100.0))",
                    "description": "Total revenue after discounts"
                },
                {
                    "name": "total_quantity",
                    "expression": "SUM(quantity)",
                    "description": "Total quantity sold"
                },
                {
                    "name": "avg_order_value",
                    "expression": "AVG(quantity * unit_price * (1 - discount_pct/100.0))",
                    "description": "Average order value"
                },
                {
                    "name": "total_discount",
                    "expression": "SUM(quantity * unit_price * discount_pct/100.0)",
                    "description": "Total discount amount"
                },
                {
                    "name": "total_shipping",
                    "expression": "SUM(shipping_cost)",
                    "description": "Total shipping costs"
                },
                {
                    "name": "avg_discount_pct",
                    "expression": "AVG(discount_pct)",
                    "description": "Average discount percentage"
                },
                {
                    "name": "gross_profit",
                    "expression": "SUM((unit_price - unit_cost) * quantity * (1 - discount_pct/100.0))",
                    "description": "Gross profit (revenue - cost)"
                },
                {
                    "name": "profit_margin",
                    "expression": "AVG((unit_price - unit_cost) / unit_price * 100)",
                    "description": "Average profit margin percentage"
                }
            ],
            "default_time_dimension": "order_date"
        },
        "sales_analysis": {
            "name": "sales_analysis",
            "display_name": "Sales Analysis",
            "description": "Comprehensive sales data for multi-dimensional analysis including revenue, quantity, profit, and customer metrics. Source: the denormalized sales_data view (sample data is generated automatically when no OLAP database is configured)",
            "source_table": "sales_data",
            "joins": [],
            "dimensions": [
                "order_date",
                "region",
                "customer_segment",
                "product_category",
                "product_name",
                "sales_rep",
                "date",
                "quarter",
                "order_year",
                "order_month",
                "payment_method",
                "customer_id"
            ],
            "measures": [
                "revenue",
                "quantity",
                "profit",
                "discount",
                "cost",
                "order_count",
                "avg_order_value",
                "profit_margin"
            ],
            "default_time_dimension": "order_date"
        },
        "customer_analytics": {
            "name": "customer_analytics",
            "display_name": "Customer Analytics",
            "description": "Customer behavior and segmentation analysis with purchase history and lifetime value metrics. Source: the customer_data view, one row per customer and order (customers without orders appear once), generated with the sample data when no OLAP database is configured",
            "source_table": "customer_data",
            "joins": [],
            "dimensions": [
                "customer_segment",
                "region",
                "city",
                "signup_date",
                "customer_tier"
            ],
            "measures": [
                "customer_count",
                "total_revenue",
                "avg_customer_value",
                "order_count",
                "avg_orders_per_customer"
            ],
            "default_time_dimension": "signup_date"
        },
        "inventory_analysis": {
            "name": "inventory_analysis",
            "display_name": "Inventory Analysis",
            "description": "Product inventory levels, reorder points and days of supply by warehouse and supplier. Source: the inventory_data table, a stock snapshot per product and distribution centre, generated with the sample data when no OLAP database is configured",
            "source_table": "inventory_data",
            "joins": [],
            "dimensions": [
                "product_category",
                "product_name",
                "warehouse",
                "supplier"
            ],
            "measures": [
                "stock_quantity",
                "unit_cost",
                "total_value",
                "reorder_point",
                "days_of_supply"
            ],
            "default_time_dimension": null
        },
        "financial_metrics": {
            "name": "financial_metrics",
            "display_name": "Financial Metrics",
            "description": "Financial performance metrics including revenue, costs, and profitability analysis",
            "source_table": "sales_data",
            "joins": [],
            "dimensions": [
                "order_date",
                "region",
                "product_category",
                "cost_center",
                "date",
                "quarter"
            ],
            "measures": [
                "revenue",
                "cost",
                "profit",
                "gross_margin",
                "operating_margin",
                "contribution_margin"
            ],
            "default_time_dimension": "order_date"
        }
    }
}
