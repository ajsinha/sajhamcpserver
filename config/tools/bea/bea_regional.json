{
  "name": "bea_regional",
  "implementation": "sajha.tools.impl.bea_tools.BeaRegionalTool",
  "description": "State, county and metro statistics (Regional dataset): personal income, GDP by state, employment, price parities; one series per area.\nReturns: source, table, title, series (code, geo_fips, geo_name, unit, observations date/value).\nInputs (* required): table* (e.g. SAINC1, SAGDP1, SQGDP1, CAINC1), line_code (default 1), geography (STATE, COUNTY, MSA, a state code for its counties, or FIPS codes; default STATE), years (default last three), max_series (default 100).\nExample: {\"table\": \"SAINC1\", \"line_code\": 3, \"geography\": [\"STATE\"], \"years\": [2024]}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 86400,
  "api_key": "${BEA_API_KEY:}",
  "inputSchema": {
    "type": "object",
    "properties": {
      "table": {
        "type": "string",
        "pattern": "^[A-Za-z0-9\\-]{3,16}$",
        "description": "Regional table name, e.g. SAINC1"
      },
      "line_code": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "description": "Line (statistic) in the table"
      },
      "geography": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{2,6}$"
        },
        "minItems": 1,
        "maxItems": 60,
        "default": [
          "STATE"
        ],
        "description": "STATE, COUNTY, MSA, a state code (its counties) or FIPS codes"
      },
      "years": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1929,
          "maximum": 2100
        },
        "minItems": 1,
        "maxItems": 20,
        "description": "Years (default the last three)"
      },
      "max_series": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 100,
        "description": "Series cap"
      }
    },
    "required": [
      "table"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "table": "SAINC1",
        "line_code": 3,
        "geography": [
          "STATE"
        ],
        "years": [
          2024
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "source": {
        "type": "string",
        "description": "Source: BEA ... not endorsed or certified by BEA; cite it with the data"
      },
      "dataset": {
        "type": "string",
        "description": "BEA dataset"
      },
      "title": {
        "type": [
          "string",
          "null"
        ],
        "description": "Table title"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "What was cut"
      },
      "notes": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": "BEA table notes"
      },
      "years": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "description": "Years asked for"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "key",
            "observations"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (CL_UNIT), e.g. Level, Percent change, USD"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions, billions or null"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "value"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY, YYYY-Qn or YYYY-MM"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in unit times unit_multiplier"
                  }
                }
              }
            },
            "code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Table and line code"
            },
            "geo_fips": {
              "type": [
                "string",
                "null"
              ],
              "description": "FIPS code"
            },
            "geo_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Area name"
            }
          }
        }
      },
      "table": {
        "type": "string",
        "description": "Table asked for"
      },
      "line_code": {
        "type": "integer",
        "description": "Line asked for"
      },
      "geography": {
        "type": "string",
        "description": "GeoFips asked for"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "bea",
      "regional",
      "states",
      "personal income"
    ]
  }
}
