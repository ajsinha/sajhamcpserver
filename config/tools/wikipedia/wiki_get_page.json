{
  "name": "wiki_get_page",
  "implementation": "sajha.tools.impl.wikipedia_tool.WikiGetPageTool",
  "description": "The full plain-text content of one Wikipedia article, split into sections, with categories, links and revision details.\nReturns {title, page_id, url, language, content (full text), summary (first paragraph), sections: [{title, level, content}], categories, images (lead image only), links {internal (article titles), external (URLs), truncated} when include_links, last_modified, last_modified_by, revision_id, word_count, last_updated}.\nInputs (* required): query (string, exact title) or page_id (integer); one is needed, page_id wins. language (Wikipedia language code such as en, fr, de, zh; default en), redirect (boolean, default true; false returns the redirect page itself), include_images (boolean, default true), include_links (boolean, default true: up to 500 article and 500 external links, one extra request).\nLarge output; for an overview use wiki_get_summary.\nExample: {\"query\": \"Value at risk\", \"include_links\": false}\nNo API key. A title that does not exist gives 'Page not found'.",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Article title or exact page name (e.g., 'Machine Learning', 'Python (programming language)', 'World War II')",
        "minLength": 1,
        "maxLength": 300
      },
      "page_id": {
        "type": "integer",
        "description": "Wikipedia page ID (alternative to title for exact page retrieval)",
        "minimum": 1
      },
      "language": {
        "type": "string",
        "description": "Wikipedia language edition (e.g., 'en', 'es', 'fr', 'de', 'zh')",
        "pattern": "^[a-z][a-z-]{1,15}$",
        "default": "en"
      },
      "redirect": {
        "type": "boolean",
        "description": "Follow redirects to the target article",
        "default": true
      },
      "include_images": {
        "type": "boolean",
        "description": "Include image URLs from the article",
        "default": true
      },
      "include_links": {
        "type": "boolean",
        "description": "Include up to 500 article links (main namespace) and 500 external links; one extra request",
        "default": true
      }
    },
    "oneOf": [
      {
        "required": [
          "query"
        ]
      },
      {
        "required": [
          "page_id"
        ]
      }
    ],
    "examples": [{"query": "Value at risk", "include_links": false}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Article title"
      },
      "page_id": {
        "type": "integer",
        "description": "Wikipedia page ID"
      },
      "url": {
        "type": "string",
        "description": "Full URL to the article"
      },
      "language": {
        "type": "string",
        "description": "Wikipedia language edition"
      },
      "content": {
        "type": "string",
        "description": "Full article content in plain text"
      },
      "summary": {
        "type": "string",
        "description": "Brief summary/lead section of the article"
      },
      "sections": {
        "type": "array",
        "description": "Article sections with headings",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "level": {
              "type": "integer"
            },
            "content": {
              "type": "string"
            }
          }
        }
      },
      "images": {
        "type": "array",
        "description": "Image URLs from the article",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "links": {
        "type": "object",
        "description": "internal (article titles), external (URLs), truncated (more links exist than were returned)",
        "properties": {
          "internal": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "categories": {
        "type": "array",
        "description": "Wikipedia categories for this article",
        "items": {
          "type": "string"
        }
      },
      "last_modified": {
        "type": "string",
        "description": "Last modification timestamp (ISO format)"
      },
      "last_modified_by": {
        "type": "string",
        "description": "Username of last editor"
      },
      "revision_id": {
        "type": "integer",
        "description": "Current revision ID"
      },
      "word_count": {
        "type": "integer",
        "description": "Total word count"
      },
      "last_updated": {
        "type": "string",
        "description": "Timestamp when data was retrieved (ISO format)"
      }
    },
    "required": [
      "title",
      "page_id",
      "url",
      "content"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Information Retrieval",
    "tags": [
      "wikipedia",
      "articles",
      "content",
      "knowledge",
      "encyclopedia",
      "full text"
    ],
    "rateLimit": 100,
    "cacheTTL": 3600,
    "note": "Retrieve complete Wikipedia article content including text, images, links, and metadata. Ideal for in-depth research and content analysis.",
    "examples": [
      {
        "description": "Get the Machine Learning article",
        "input": {
          "query": "Machine Learning"
        }
      },
      {
        "description": "Get article with images and links",
        "input": {
          "query": "Eiffel Tower",
          "include_images": true,
          "include_links": true
        }
      },
      {
        "description": "Get article by page ID",
        "input": {
          "page_id": 5043734
        }
      },
      {
        "description": "Get Spanish article",
        "input": {
          "query": "Inteligencia artificial",
          "language": "es"
        }
      }
    ],
    "useCases": [
      "In-depth research",
      "Content analysis",
      "Knowledge extraction",
      "Fact-checking",
      "Educational content",
      "Article archiving"
    ]
  }
}
