{
  "name": "fbi_get_crime_trend",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetCrimeTrendTool",
  "description": "Year-by-year offense counts and rates with trend statistics, for the nation, a state or an agency",
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string",
        "description": "Offense (UCR summarized offense category)",
        "enum": [
          "violent_crime",
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "property_crime",
          "burglary",
          "larceny",
          "motor_vehicle_theft",
          "arson"
        ]
      },
      "start_year": {
        "type": "integer",
        "description": "First year",
        "minimum": 1985,
        "maximum": 2100
      },
      "end_year": {
        "type": "integer",
        "description": "Last year",
        "minimum": 1985,
        "maximum": 2100
      },
      "state": {
        "type": "string",
        "description": "Optional: state-level trend",
        "pattern": "^[A-Za-z]{2}$"
      },
      "ori": {
        "type": "string",
        "description": "Optional: agency-level trend (takes precedence over state)",
        "pattern": "^[A-Za-z0-9]{9}$"
      },
      "per_capita": {
        "type": "boolean",
        "description": "Compute changes on the rate per 100,000 (true) or on counts (false)",
        "default": true
      }
    },
    "required": [
      "offense_type",
      "start_year",
      "end_year"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string"
      },
      "scope": {
        "type": "string",
        "enum": [
          "national",
          "state",
          "agency"
        ]
      },
      "metric": {
        "type": "string",
        "enum": [
          "rate_per_100k",
          "total_incidents"
        ]
      },
      "time_period": {
        "type": "object",
        "properties": {
          "start_year": {
            "type": "integer"
          },
          "end_year": {
            "type": "integer"
          },
          "years_analyzed": {
            "type": "integer"
          }
        }
      },
      "time_series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer"
            },
            "total_incidents": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rate_per_100k": {
              "type": [
                "number",
                "null"
              ]
            },
            "months_reported": {
              "type": "integer"
            },
            "percent_change": {
              "type": [
                "number",
                "null"
              ],
              "description": "Change in the metric from the previous year"
            }
          }
        }
      },
      "trend_analysis": {
        "type": "object",
        "properties": {
          "overall_change": {
            "type": "number",
            "description": "Percent change, first to last year"
          },
          "average_annual_change": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "increasing",
              "decreasing",
              "stable"
            ]
          },
          "peak_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lowest_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "volatility": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "offense_type",
      "scope",
      "time_period",
      "time_series",
      "trend_analysis"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "trend",
      "analysis",
      "time series"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "One call to /summarized/{national | state/{state} | agency/{ori}}/{offense} covering the whole range.",
    "examples": [
      {
        "description": "National violent crime, 2015-2024",
        "input": {
          "offense_type": "violent_crime",
          "start_year": 2015,
          "end_year": 2024
        }
      },
      {
        "description": "California property crime counts",
        "input": {
          "offense_type": "property_crime",
          "state": "CA",
          "start_year": 2018,
          "end_year": 2024,
          "per_capita": false
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
