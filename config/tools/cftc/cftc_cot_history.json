{
  "name": "cftc_cot_history",
  "implementation": "sajha.tools.impl.cftc_tools.CftcCotHistoryTool",
  "description": "Weekly Commitments of Traders positions for one market between two dates, newest first.\nReturns: code, market, count, reports (report_date, open_interest, categories).\nInputs (* required): market*, report, kind, from, to (YYYY-MM-DD), categories, limit (default 104).\nExample: {\"market\": \"088691\", \"report\": \"disaggregated\", \"from\": \"2025-09-01\", \"to\": \"2025-09-30\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "market": {
        "type": "string",
        "description": "CFTC contract market code (e.g. 13874A) or a market name",
        "minLength": 2
      },
      "report": {
        "type": "string",
        "description": "legacy, disaggregated (commodities) or tff (financial futures)",
        "enum": [
          "legacy",
          "disaggregated",
          "tff"
        ],
        "default": "legacy"
      },
      "kind": {
        "type": "string",
        "description": "futures_only or combined (futures and options)",
        "enum": [
          "futures_only",
          "combined"
        ],
        "default": "futures_only"
      },
      "from": {
        "type": "string",
        "description": "First report date, YYYY-MM-DD",
        "format": "date"
      },
      "to": {
        "type": "string",
        "description": "Last report date, YYYY-MM-DD",
        "format": "date"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Only these categories (e.g. managed_money)"
      },
      "limit": {
        "type": "integer",
        "description": "Most reports returned",
        "minimum": 1,
        "maximum": 1000,
        "default": 104
      }
    },
    "required": [
      "market"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "market": "088691",
        "report": "disaggregated",
        "from": "2025-09-01",
        "to": "2025-09-30"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "reports"
    ],
    "properties": {
      "report": {
        "type": "string",
        "description": "legacy, disaggregated or tff"
      },
      "report_name": {
        "type": "string",
        "description": "Report name"
      },
      "kind": {
        "type": "string",
        "description": "futures_only or combined"
      },
      "dataset": {
        "type": "string",
        "description": "Socrata dataset id"
      },
      "source": {
        "type": "string",
        "description": "Source: CFTC ...; cite it with the data"
      },
      "units": {
        "type": "string",
        "description": "Units of the numbers"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data"
      },
      "code": {
        "type": "string",
        "description": "CFTC contract market code"
      },
      "market": {
        "type": [
          "string",
          "null"
        ],
        "description": "Market and exchange"
      },
      "from": {
        "type": [
          "string",
          "null"
        ],
        "description": "From date"
      },
      "to": {
        "type": [
          "string",
          "null"
        ],
        "description": "To date"
      },
      "count": {
        "type": "integer",
        "description": "Reports returned"
      },
      "truncated": {
        "type": "boolean",
        "description": "More reports exist; raise limit"
      },
      "reports": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "report_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "Report date (Tuesday), YYYY-MM-DD"
            },
            "market": {
              "type": [
                "string",
                "null"
              ],
              "description": "Market and exchange"
            },
            "code": {
              "type": [
                "string",
                "null"
              ],
              "description": "CFTC contract market code"
            },
            "commodity": {
              "type": [
                "string",
                "null"
              ],
              "description": "Commodity"
            },
            "contract_units": {
              "type": [
                "string",
                "null"
              ],
              "description": "Contract size"
            },
            "open_interest": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Open interest, contracts"
            },
            "change_in_open_interest": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Weekly change in open interest"
            },
            "traders_total": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Reportable traders"
            },
            "categories": {
              "type": "object",
              "description": "Trader categories of the report",
              "additionalProperties": {
                "type": "object",
                "description": "One trader category (contracts; pct_* in percent of open interest)",
                "properties": {
                  "long": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Long positions"
                  },
                  "short": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Short positions"
                  },
                  "spread": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Spreading positions"
                  },
                  "net": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Long minus short"
                  },
                  "change_long": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Weekly change in long"
                  },
                  "change_short": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Weekly change in short"
                  },
                  "traders_long": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Traders long"
                  },
                  "traders_short": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Traders short"
                  },
                  "pct_long": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Long, percent of open interest",
                    "x-sajha-unit": "percent"
                  },
                  "pct_short": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Short, percent of open interest",
                    "x-sajha-unit": "percent"
                  },
                  "net_pct_of_open_interest": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Net long, percent of open interest",
                    "x-sajha-unit": "percent"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "cftc",
      "commitments of traders",
      "cot",
      "futures",
      "positioning"
    ]
  }
}
