{
  "name": "gdelt_articles",
  "implementation": "sajha.tools.impl.gdelt_tools.GdeltArticlesTool",
  "title": "News articles (GDELT)",
  "description": "News articles from outlets worldwide (in many languages, machine-translated by GDELT) that match a query in a date range of up to three months.\nReturns: query, from, to, count, truncated, articles (url, title, seen_at, domain, language, source_country).\nInputs: query; from, to (default the last 7 days; at most 92 days); max_records (default 25); sort (date, relevance, tone_ascending, tone_descending; default date); source_country, language, domain.\nExample: {\"query\": \"\\\"interest rates\\\" inflation\", \"from\": \"2026-10-01\", \"to\": \"2026-10-07\", \"max_records\": 10}",
  "annotations": {
    "title": "News articles (GDELT)",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 3600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "GDELT query: words, \"exact phrases\", OR in parentheses, -excluded",
        "minLength": 2,
        "maxLength": 300
      },
      "from": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "First day (YYYY-MM-DD, UTC)"
      },
      "to": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Last day (YYYY-MM-DD, UTC)"
      },
      "max_records": {
        "type": "integer",
        "description": "Most articles to return",
        "minimum": 1,
        "maximum": 250,
        "default": 25
      },
      "sort": {
        "type": "string",
        "enum": [
          "date",
          "relevance",
          "tone_ascending",
          "tone_descending"
        ],
        "description": "Order of results",
        "default": "date"
      },
      "source_country": {
        "type": "string",
        "description": "Only outlets in this country (GDELT country name or FIPS code, e.g. UK, japan)",
        "maxLength": 40
      },
      "language": {
        "type": "string",
        "description": "Only articles in this language (e.g. english, french)",
        "maxLength": 30
      },
      "domain": {
        "type": "string",
        "description": "Only this outlet domain (e.g. reuters.com)",
        "maxLength": 100
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "query": "\"interest rates\" inflation",
        "from": "2026-10-01",
        "to": "2026-10-07",
        "max_records": 10
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "from": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "count": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "articles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "seen_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "domain": {
              "type": [
                "string",
                "null"
              ]
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_country": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "url"
          ]
        }
      },
      "source": {
        "type": "string",
        "description": "Attribution"
      }
    },
    "required": [
      "articles",
      "source"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "News and events",
    "tags": [
      "gdelt",
      "news",
      "media coverage"
    ]
  }
}
