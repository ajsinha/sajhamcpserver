{
  "name": "fbi_get_offense_data",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetOffenseDataTool",
  "description": "NIBRS incident breakdowns for an offense (victim and offender age/sex/race, weapons, locations, relationships), nationally or for a state",
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string",
        "description": "NIBRS offense (the violent/property aggregates and larceny as a whole have no single NIBRS code)",
        "enum": [
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "simple_assault",
          "burglary",
          "motor_vehicle_theft",
          "arson",
          "kidnapping",
          "identity_theft"
        ]
      },
      "state": {
        "type": "string",
        "description": "Optional two-letter state code; omit for national",
        "pattern": "^[A-Za-z]{2}$"
      },
      "year": {
        "type": "integer",
        "description": "Data year (defaults to last calendar year)",
        "minimum": 1985,
        "maximum": 2100
      },
      "include_subcategories": {
        "type": "boolean",
        "description": "Include the victim/offender/offense breakdowns",
        "default": true
      },
      "top_n": {
        "type": "integer",
        "description": "Largest buckets kept per breakdown",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      }
    },
    "required": [
      "offense_type"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string"
      },
      "nibrs_offense_code": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "scope": {
        "type": "string",
        "enum": [
          "national",
          "state"
        ]
      },
      "state": {
        "type": "string"
      },
      "total_offenses": {
        "type": [
          "integer",
          "null"
        ],
        "description": "NIBRS offenses reported in the year"
      },
      "rate_per_100k": {
        "type": [
          "number",
          "null"
        ]
      },
      "nibrs_population_coverage_pct": {
        "type": [
          "number",
          "null"
        ]
      },
      "breakdown": {
        "type": "object",
        "description": "victim, offender and offense breakdowns; each maps a dimension to {bucket: count}"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "offense_type",
      "nibrs_offense_code",
      "year",
      "scope",
      "total_offenses"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "offense",
      "detailed",
      "ucr"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Calls /nibrs/{national | state/{state}}/{code} with type=counts and type=totals. NIBRS covers only agencies that report incident-level data.",
    "examples": [
      {
        "description": "Who are aggravated-assault victims nationally, 2024",
        "input": {
          "offense_type": "aggravated_assault",
          "year": 2024
        }
      },
      {
        "description": "Robbery in Vermont",
        "input": {
          "offense_type": "robbery",
          "state": "VT",
          "year": 2024,
          "top_n": 5
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
