{
  "name": "bis_property_prices",
  "implementation": "sajha.tools.impl.bis_tools.BisPropertyPricesTool",
  "description": "Property prices, quarterly: residential (BIS WS_SPP; real or nominal; index 2010=100 or year-on-year percent) or commercial (WS_CPP, nominal). Detail: bis_get_series on WS_DPP.\nReturns: dataflow, key, source, series (country, title, unit, frequency, observations date/value).\nInputs (* required): countries*, type (residential or commercial), real (default true), measure (index or yoy_change), period (default last 5 years).\nExample: {\"countries\": [\"US\", \"DE\"], \"measure\": \"yoy_change\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "countries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2
        },
        "minItems": 1,
        "maxItems": 20,
        "description": "ISO 3166 alpha-2 codes (XM euro area), alpha-3 or names"
      },
      "type": {
        "type": "string",
        "description": "residential or commercial",
        "enum": [
          "residential",
          "commercial"
        ],
        "default": "residential"
      },
      "real": {
        "type": "boolean",
        "description": "Residential: deflated by CPI (true) or nominal (false)",
        "default": true
      },
      "measure": {
        "type": "string",
        "description": "Residential: index level or year-on-year change",
        "enum": [
          "index",
          "yoy_change"
        ],
        "default": "index"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N days|months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 5 years"
      }
    },
    "required": [
      "countries"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "countries": [
          "US",
          "DE"
        ],
        "measure": "yoy_change"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "BIS dataflow (WS_CBPOL, WS_TC, ...)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: BIS ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "BIS area code"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "description": "BIS series title"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Per cent per year, Percentage of GDP, Index, 2010 = 100)"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions, billions or null"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Daily, Monthly, Quarterly, ..."
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM-DD, YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "bis",
      "property prices",
      "house prices",
      "real estate"
    ]
  }
}
