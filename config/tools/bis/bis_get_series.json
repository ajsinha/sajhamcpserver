{
  "name": "bis_get_series",
  "implementation": "sajha.tools.impl.bis_tools.BisGetSeriesTool",
  "description": "Any BIS SDMX dataflow and key (the escape hatch): dimensions joined by dots, + for several codes, empty for all.\nReturns: dataflow, key, source, series (country, title, unit, frequency, observations date/value).\nInputs (* required): dataflow* (e.g. WS_DPP), key*, period (default last 5 years), max_series (1-100, default 20).\nExample: {\"dataflow\": \"WS_DSR\", \"key\": \"Q.US.H\", \"period\": \"latest\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "BIS dataflow id",
        "pattern": "^[A-Za-z0-9_]{2,40}$"
      },
      "key": {
        "type": "string",
        "description": "SDMX key, e.g. Q.US.R.628",
        "pattern": "^[A-Za-z0-9_.+]{0,200}$"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N days|months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 5 years"
      },
      "max_series": {
        "type": "integer",
        "description": "Most series returned",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      }
    },
    "required": [
      "dataflow",
      "key"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "dataflow": "WS_DSR",
        "key": "Q.US.H",
        "period": "latest"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "BIS dataflow (WS_CBPOL, WS_TC, ...)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: BIS ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "BIS area code"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "description": "BIS series title"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Per cent per year, Percentage of GDP, Index, 2010 = 100)"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions, billions or null"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Daily, Monthly, Quarterly, ..."
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM-DD, YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "bis",
      "sdmx",
      "statistics"
    ]
  }
}
