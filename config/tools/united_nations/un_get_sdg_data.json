{
  "name": "un_get_sdg_data",
  "implementation": "sajha.tools.impl.united_nations_tool_refactored.UNGetSDGDataTool",
  "description": "Time series of one SDG indicator from the UN Statistics Division SDG API (Indicator/Data, no API key), for one country or area or for all. The API keys areas by UN M49 number, so an ISO alpha-3 or alpha-2 country code is converted (IND -> 356).\nReturns: indicator_code, indicator_description, country_code, area_code (M49 used), country_name, data (year, value (null when not numeric, with value_text), unit, series, series_description, dimensions such as sex or age; plus area_code and area_name when no country is given), count, total_available, truncated; a note when empty.\nInputs (* required): indicator_code* (such as 1.1.1 or 3.2.1); country_code (ISO3, ISO2 or M49, e.g. 1 for World; omit for all areas); start_year, end_year (2000-2030; either alone is fine); max_records (1-5000; default 500).\nIndicator codes: un_get_sdg_indicators. For World Bank series use wb_get_country_data.\nExample: {\"indicator_code\": \"3.2.1\", \"country_code\": \"IND\", \"start_year\": 2015, \"end_year\": 2023}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "indicator_code": {
        "type": "string",
        "description": "SDG indicator code (e.g., '1.1.1' for poverty headcount ratio, '3.2.1' for under-5 mortality rate)"
      },
      "country_code": {
        "type": "string",
        "description": "Country or area: ISO alpha-3 (IND), alpha-2 (IN) or UN M49 number (356; 1 = World). Omit for all areas."
      },
      "start_year": {
        "type": "integer",
        "description": "Start year for data retrieval (e.g., 2015)",
        "minimum": 2000,
        "maximum": 2030
      },
      "end_year": {
        "type": "integer",
        "description": "End year for data retrieval (e.g., 2024)",
        "minimum": 2000,
        "maximum": 2030
      },
      "max_records": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "default": 500,
        "description": "Most observations returned (the API pages through results)"
      }
    },
    "required": [
      "indicator_code"
    ],
    "examples": [{"indicator_code": "3.2.1", "country_code": "IND", "start_year": 2015, "end_year": 2023}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "indicator_code": {
        "type": "string",
        "description": "SDG indicator code"
      },
      "indicator_description": {
        "type": "string",
        "description": "Full description of the indicator"
      },
      "country_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "country_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "data": {
        "type": "array",
        "description": "Time series data points",
        "items": {
          "type": "object",
          "properties": {
            "year": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Year of observation"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Indicator value (null if not available)"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit of measurement"
            },
            "series": {
              "type": [
                "string",
                "null"
              ]
            },
            "series_description": {
              "type": [
                "string",
                "null"
              ]
            },
            "dimensions": {
              "type": "object"
            },
            "value_text": {
              "type": "string"
            },
            "area_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "area_name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "year",
            "value"
          ]
        }
      },
      "count": {
        "type": "integer",
        "description": "Number of data points returned"
      },
      "area_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "total_available": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "note": {
        "type": "string"
      }
    },
    "required": [
      "indicator_code",
      "data",
      "count"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Global Statistics",
    "tags": [
      "un",
      "sdg",
      "time series",
      "historical data",
      "country data"
    ],
    "rateLimit": 60,
    "cacheTTL": 3600,
    "note": "Retrieves actual measurement data for SDG indicators. Data availability varies by country and indicator. Some indicators are updated annually, others less frequently.",
    "examples": [
      {
        "description": "Get poverty rate data for India (indicator 1.1.1)",
        "input": {
          "indicator_code": "1.1.1",
          "country_code": "IND",
          "start_year": 2015,
          "end_year": 2023
        }
      },
      {
        "description": "Get global renewable energy data (indicator 7.2.1)",
        "input": {
          "indicator_code": "7.2.1",
          "start_year": 2010,
          "end_year": 2024
        }
      },
      {
        "description": "Get recent maternal mortality data for Brazil",
        "input": {
          "indicator_code": "3.1.1",
          "country_code": "BRA"
        }
      }
    ],
    "useCases": [
      "Track country progress on specific SDG indicators",
      "Compare historical trends",
      "Generate data visualizations and charts",
      "Research and policy analysis",
      "Report generation"
    ]
  }
}
