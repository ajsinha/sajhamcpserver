{
  "name": "un_compare_trade",
  "implementation": "sajha.tools.impl.united_nations_tool_refactored.UNCompareCountryTradeTool",
  "description": "Compare total goods exports or imports (USD) of 2 to 10 countries for one year, ranked, from UN Comtrade (one query per country, partner world).\nReturns: trade_flow, year and countries (country_code, total_value, rank by value; note or error when a country has no data) plus a source note.\nInputs (* required): country_codes* (array of 2-10 ISO3 or numeric Comtrade codes); trade_flow (export, import, re_export, re_import; default export); year (1962-2030; default the current year minus 2).\nFor one country's partners use un_get_country_trade. Key: optional COMTRADE_API_KEY for the full Comtrade API; without it the keyless preview API (500 rows, rate limited).\nExample: {\"country_codes\": [\"USA\", \"CHN\", \"DEU\", \"JPN\"], \"trade_flow\": \"export\", \"year\": 2022}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "country_codes": {
        "type": "array",
        "description": "List of ISO3 country codes to compare (minimum 2, maximum 10 countries)",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 10
      },
      "trade_flow": {
        "type": "string",
        "description": "Trade flow to compare across countries",
        "enum": [
          "export",
          "import",
          "re_export",
          "re_import"
        ],
        "default": "export"
      },
      "year": {
        "type": "integer",
        "description": "Year for comparison (same year for all countries)",
        "minimum": 1962,
        "maximum": 2030
      }
    },
    "required": [
      "country_codes"
    ],
    "examples": [{"country_codes": ["USA", "CHN", "DEU", "JPN"], "trade_flow": "export", "year": 2022}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "trade_flow": {
        "type": "string",
        "description": "Trade flow being compared"
      },
      "year": {
        "type": "integer",
        "description": "Comparison year"
      },
      "countries": {
        "type": "array",
        "description": "Trade data for each country",
        "items": {
          "type": "object",
          "properties": {
            "country_code": {
              "type": "string",
              "description": "Country code"
            },
            "country_name": {
              "type": "string",
              "description": "Country name"
            },
            "total_value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Total trade value in USD"
            },
            "rank": {
              "type": "integer",
              "description": "Rank among compared countries"
            },
            "top_partners": {
              "type": "array",
              "description": "Top trading partners"
            }
          }
        }
      },
      "summary": {
        "type": "object",
        "description": "Comparison summary statistics",
        "properties": {
          "highest": {
            "type": "object",
            "description": "Country with highest trade value"
          },
          "lowest": {
            "type": "object",
            "description": "Country with lowest trade value"
          }
        }
      }
    },
    "required": [
      "trade_flow",
      "year",
      "countries"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Global Statistics",
    "tags": [
      "un",
      "comtrade",
      "comparison",
      "benchmarking",
      "multi-country",
      "trade analysis"
    ],
    "rateLimit": 60,
    "cacheTTL": 3600,
    "note": "Compare trade performance across multiple countries (one Comtrade query per country, ranked by value). Useful for regional analysis, competitive positioning, and identifying trade leaders. Uses the keyless UN Comtrade public preview API; set COMTRADE_API_KEY to use the full data API.",
    "examples": [
      {
        "description": "Compare exports among BRICS countries in 2022",
        "input": {
          "country_codes": [
            "BRA",
            "RUS",
            "IND",
            "CHN",
            "ZAF"
          ],
          "trade_flow": "export",
          "year": 2022
        }
      },
      {
        "description": "Compare imports for major Asian economies",
        "input": {
          "country_codes": [
            "CHN",
            "JPN",
            "IND",
            "KOR"
          ],
          "trade_flow": "import",
          "year": 2023
        }
      },
      {
        "description": "Compare exports across G7 countries",
        "input": {
          "country_codes": [
            "USA",
            "CAN",
            "GBR",
            "FRA",
            "DEU",
            "ITA",
            "JPN"
          ],
          "trade_flow": "export"
        }
      }
    ],
    "useCases": [
      "Regional trade analysis",
      "Competitive benchmarking",
      "Economic bloc comparison (EU, ASEAN, etc.)",
      "Trade policy impact assessment",
      "Market opportunity identification"
    ]
  },
  "comtrade_api_key": "${COMTRADE_API_KEY:}"
}
