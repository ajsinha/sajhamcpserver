{
  "name": "eurostat_unemployment",
  "implementation": "sajha.tools.impl.eurostat_tools.EurostatUnemploymentTool",
  "description": "Monthly unemployment rate, seasonally adjusted, percent of the labour force (Eurostat une_rt_m); also the US and Japan (not Eurostat's own data).\nReturns: source, flags, series (country, unit, last_update, observations date/value/flag).\nInputs (* required): countries*, sex (total, male, female), age (total, under_25, 25_74), period (default last 12 months).\nExample: {\"countries\": [\"ES\", \"DE\", \"EA\"], \"period\": \"last 12 months\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "countries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2
        },
        "minItems": 1,
        "maxItems": 30,
        "description": "ISO 3166 codes or names; EA (euro area, EA21), EU (EU27_2020), or Eurostat codes"
      },
      "sex": {
        "type": "string",
        "enum": [
          "total",
          "male",
          "female"
        ],
        "default": "total",
        "description": "Sex"
      },
      "age": {
        "type": "string",
        "enum": [
          "total",
          "under_25",
          "25_74"
        ],
        "default": "total",
        "description": "Age group: total (15 to 74), under_25, 25_74"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 12 months"
      }
    },
    "required": [
      "countries"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "countries": [
          "ES",
          "DE",
          "EA"
        ],
        "period": "last 12 months"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataset": {
        "type": "string",
        "description": "Eurostat dataset code"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: Eurostat ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "flags": {
        "type": "object",
        "description": "Observation flags present, with their meaning",
        "additionalProperties": {
          "type": "string"
        }
      },
      "reuse_note": {
        "type": "string",
        "description": "Present when a country's data is not Eurostat's own"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "Eurostat geo code"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Annual rate of change, percent)"
            },
            "unit_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Eurostat unit code"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly, Quarterly, Annual, ..."
            },
            "last_update": {
              "type": [
                "string",
                "null"
              ],
              "description": "When Eurostat last updated the dataset (YYYY-MM-DD)"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit",
                    "x-sajha-unit": "percent"
                  },
                  "flag": {
                    "type": "string",
                    "description": "Eurostat flag: p provisional, e estimated, b break, ..."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "eurostat",
      "unemployment",
      "labour market"
    ]
  }
}
