{
  "name": "eurostat_get_series",
  "implementation": "sajha.tools.impl.eurostat_tools.EurostatGetSeriesTool",
  "description": "Any Eurostat dataset (the escape hatch): filters give a code or codes per dimension; a dimension left out matches all.\nReturns: source, flags, series (country, unit, last_update, observations date/value/flag).\nInputs (* required): dataset* (find it with eurostat_search), filters (dimension to codes), period (default last 3 years), max_series (default 20).\nExample: {\"dataset\": \"prc_hicp_minr\", \"filters\": {\"freq\": \"M\", \"unit\": \"RCH_A\", \"coicop18\": \"TOTAL\", \"geo\": [\"DE\", \"FR\"]}, \"period\": \"last 12 months\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "dataset": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "description": "Eurostat dataset code, e.g. prc_hicp_minr, namq_10_gdp, une_rt_m"
      },
      "filters": {
        "type": "object",
        "description": "Dimension id to a code or a list of codes; geo accepts ISO codes",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 3 years"
      },
      "max_series": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "Most series returned"
      }
    },
    "required": [
      "dataset"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "dataset": "prc_hicp_minr",
        "filters": {
          "freq": "M",
          "unit": "RCH_A",
          "coicop18": "TOTAL",
          "geo": [
            "DE",
            "FR"
          ]
        },
        "period": "last 12 months"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataset": {
        "type": "string",
        "description": "Eurostat dataset code"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: Eurostat ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "flags": {
        "type": "object",
        "description": "Observation flags present, with their meaning",
        "additionalProperties": {
          "type": "string"
        }
      },
      "reuse_note": {
        "type": "string",
        "description": "Present when a country's data is not Eurostat's own"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "Eurostat geo code"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Annual rate of change, percent)"
            },
            "unit_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Eurostat unit code"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly, Quarterly, Annual, ..."
            },
            "last_update": {
              "type": [
                "string",
                "null"
              ],
              "description": "When Eurostat last updated the dataset (YYYY-MM-DD)"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  },
                  "flag": {
                    "type": "string",
                    "description": "Eurostat flag: p provisional, e estimated, b break, ..."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "eurostat",
      "sdmx",
      "statistics"
    ]
  }
}
