{
  "name": "eurostat_gdp",
  "implementation": "sajha.tools.impl.eurostat_tools.EurostatGdpTool",
  "description": "Quarterly GDP, seasonally adjusted (Eurostat namq_10_gdp): real growth on the previous quarter or year in percent, or current prices in million euro.\nReturns: source, flags, series (country, unit, last_update, observations date/value/flag).\nInputs (* required): countries*, measure (growth_qoq, growth_yoy or current_prices; default growth_qoq), period (default last 3 years).\nExample: {\"countries\": [\"DE\", \"IT\", \"EA\"], \"measure\": \"growth_qoq\", \"period\": \"last 3 years\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "countries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2
        },
        "minItems": 1,
        "maxItems": 30,
        "description": "ISO 3166 codes or names; EA (euro area, EA21), EU (EU27_2020), or Eurostat codes"
      },
      "measure": {
        "type": "string",
        "enum": [
          "growth_qoq",
          "growth_yoy",
          "current_prices"
        ],
        "default": "growth_qoq",
        "description": "growth_qoq and growth_yoy: chain-linked volumes, percent; current_prices: million euro"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 3 years"
      }
    },
    "required": [
      "countries"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "countries": [
          "DE",
          "IT",
          "EA"
        ],
        "measure": "growth_qoq",
        "period": "last 3 years"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataset": {
        "type": "string",
        "description": "Eurostat dataset code"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: Eurostat ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "flags": {
        "type": "object",
        "description": "Observation flags present, with their meaning",
        "additionalProperties": {
          "type": "string"
        }
      },
      "reuse_note": {
        "type": "string",
        "description": "Present when a country's data is not Eurostat's own"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "Eurostat geo code"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Annual rate of change, percent)"
            },
            "unit_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Eurostat unit code"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly, Quarterly, Annual, ..."
            },
            "last_update": {
              "type": [
                "string",
                "null"
              ],
              "description": "When Eurostat last updated the dataset (YYYY-MM-DD)"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  },
                  "flag": {
                    "type": "string",
                    "description": "Eurostat flag: p provisional, e estimated, b break, ..."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "eurostat",
      "gdp",
      "growth",
      "national accounts"
    ]
  }
}
