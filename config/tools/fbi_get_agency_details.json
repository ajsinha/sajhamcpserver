{
  "name": "fbi_get_agency_details",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetAgencyDetailsTool",
  "description": "Directory details for one law enforcement agency by ORI (name, type, county, coordinates, NIBRS status) plus its staffing from the police-employee data",
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "ori": {
        "type": "string",
        "description": "9-character agency ORI code (e.g. VT0040100); find one with fbi_search_agencies",
        "pattern": "^[A-Za-z0-9]{9}$"
      },
      "year": {
        "type": "integer",
        "description": "Year for the staffing figures (defaults to last calendar year)",
        "minimum": 1985,
        "maximum": 2100
      }
    },
    "required": [
      "ori"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ori": {
        "type": "string"
      },
      "agency_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "agency_type": {
        "type": [
          "string",
          "null"
        ]
      },
      "location": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "state_name": {
            "type": "string"
          },
          "county": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "reporting_status": {
        "type": "object",
        "properties": {
          "is_nibrs": {
            "type": "boolean"
          },
          "nibrs_start_date": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "personnel": {
        "type": [
          "object",
          "null"
        ],
        "description": "null when the agency reported no staffing for the year",
        "properties": {
          "year": {
            "type": "integer"
          },
          "male_officers": {
            "type": [
              "integer",
              "null"
            ]
          },
          "female_officers": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total_officers": {
            "type": "integer"
          },
          "male_civilians": {
            "type": [
              "integer",
              "null"
            ]
          },
          "female_civilians": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total_civilians": {
            "type": "integer"
          },
          "total_employees": {
            "type": "integer"
          },
          "employees_per_1000": {
            "type": [
              "number",
              "null"
            ]
          },
          "population_served": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "personnel_error": {
        "type": "string"
      }
    },
    "required": [
      "ori",
      "agency_name",
      "location",
      "reporting_status"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "agency",
      "details",
      "information"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Calls /agency/byStateAbbr/{state} (the state is the first two letters of the ORI) and /pe/{state}/{ori}.",
    "examples": [
      {
        "description": "Burlington (VT) Police Department",
        "input": {
          "ori": "VT0040100"
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
