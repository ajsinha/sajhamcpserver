{
  "name": "tavily_news_search",
  "implementation": "sajha.tools.impl.tavily_tool_refactored.TavilyNewsSearchTool",
  "description": "Recent news search through the Tavily search API (topic news, basic depth).\nReturns {query, search_depth, topic, results_count, results: [{title, url, content (extract), score, published_date}], answer (when include_answer)}.\nInputs (* required): query* (string), max_results (integer 1-20, default 5), include_answer (boolean, default true; a generated summary of the coverage).\nFor general web results use tavily_web_search; for news from chosen outlets tavily_domain_search with include_domains.\nExample: {\"query\": \"ECB rate decision\", \"max_results\": 10}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "api_key": "${tavily.api.key}",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "News search query"
      },
      "max_results": {
        "type": "integer",
        "description": "Maximum number of news articles to return",
        "default": 5,
        "minimum": 1,
        "maximum": 20
      },
      "include_answer": {
        "type": "boolean",
        "description": "Include AI-generated news summary",
        "default": true
      }
    },
    "required": ["query"],
    "examples": [{"query": "ECB rate decision", "max_results": 10}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "The news search query"
      },
      "results_count": {
        "type": "integer",
        "description": "Number of news articles returned"
      },
      "results": {
        "type": "array",
        "description": "News articles",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "News article title"
            },
            "url": {
              "type": "string",
              "description": "Article URL"
            },
            "content": {
              "type": "string",
              "description": "Article excerpt"
            },
            "score": {
              "type": "number",
              "description": "Relevance score"
            },
            "published_date": {
              "type": "string",
              "description": "Publication date"
            }
          }
        }
      },
      "answer": {
        "type": "string",
        "description": "AI-generated news summary"
      }
    },
    "required": ["query", "results_count", "results"]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "email": "ajsinha@gmail.com",
    "category": "News Search",
    "tags": ["news", "articles", "current events", "journalism", "media", "tavily"],
    "rateLimit": 100,
    "cacheTTL": 1800,
    "note": "Optimized for news articles with recency weighting. Requires Tavily API key for production use.",
    "examples": [
      {
        "description": "Search for breaking tech news",
        "input": {
          "query": "artificial intelligence regulations",
          "max_results": 5,
          "include_answer": true
        }
      },
      {
        "description": "Financial market news",
        "input": {
          "query": "stock market trends today",
          "max_results": 10
        }
      },
      {
        "description": "Political news summary",
        "input": {
          "query": "climate change policy updates",
          "max_results": 7,
          "include_answer": true
        }
      }
    ],
    "useCases": [
      "Breaking news monitoring",
      "Market and financial updates",
      "Political and policy tracking",
      "Technology news aggregation",
      "Industry trend analysis",
      "Event coverage and updates",
      "News briefing generation"
    ],
    "copyright": "Copyright All rights Reserved 2025-2030, Ashutosh Sinha"
  }
}
