{
  "name": "sec_get_mutual_fund_holdings",
  "implementation": "sajha.tools.impl.sec_edgar_tool_refactored.SECGetMutualFundHoldingsTool",
  "description": "Form NPORT-P monthly portfolio holdings reports filed by a registered fund (mutual fund or ETF registrant), from SEC EDGAR submissions.\nReturns {cik, name, filing_count, filings: [{accession_number, filing_date, report_date, form (NPORT-P or NPORT-P/A), primary_document, description}]}, newest first; filings only, not the positions.\nInputs (* required): cik or ticker (one is needed; cik, 10 digits or shorter, wins; a ticker is resolved through the SEC company-tickers file), limit (integer 1-20, default 5).\nedgar_mutual_fund_holdings returns the same filings with document URLs; for a manager's Form 13F-HR holdings use edgar_institutional_holdings.\nExample: {\"cik\": \"0000036405\", \"limit\": 3}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "cik": {
        "type": "string",
        "description": "Central Index Key (CIK) of the fund registrant (the investment company that files N-PORT)"
      },
      "ticker": {
        "type": "string",
        "description": "Ticker symbol, resolved through the SEC company-tickers file (fund registrants rarely have one; use cik)"
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of NPORT-P filings to return",
        "default": 5,
        "minimum": 1,
        "maximum": 20
      }
    },
    "oneOf": [
      {
        "required": [
          "cik"
        ]
      },
      {
        "required": [
          "ticker"
        ]
      }
    ],
    "examples": [{"cik": "0000036405", "limit": 3}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "cik": {
        "type": "string",
        "description": "10-digit Central Index Key"
      },
      "name": {
        "type": "string",
        "description": "Fund registrant name"
      },
      "filing_count": {
        "type": "integer",
        "description": "Number of NPORT-P filings returned"
      },
      "filings": {
        "type": "array",
        "description": "NPORT-P monthly portfolio holdings reports",
        "items": {
          "type": "object",
          "properties": {
            "accession_number": {
              "type": "string",
              "description": "Unique filing identifier"
            },
            "filing_date": {
              "type": "string",
              "description": "Date filed with SEC (YYYY-MM-DD)"
            },
            "report_date": {
              "type": "string",
              "description": "Period end date for holdings (YYYY-MM-DD)"
            },
            "form": {
              "type": "string",
              "description": "Form type (NPORT-P or NPORT-P/A)"
            },
            "primary_document": {
              "type": "string",
              "description": "Primary document filename"
            },
            "description": {
              "type": "string",
              "description": "Filing description"
            }
          },
          "required": [
            "accession_number",
            "filing_date",
            "form"
          ]
        }
      }
    },
    "required": [
      "cik",
      "name",
      "filing_count",
      "filings"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Financial Data",
    "tags": [
      "sec",
      "edgar",
      "13f",
      "institutional",
      "holdings",
      "mutual funds",
      "hedge funds",
      "portfolio"
    ],
    "rateLimit": 10,
    "cacheTTL": 3600,
    "note": "Form 13F discloses equity holdings of institutional investment managers with >$100M in AUM. Filed quarterly.",
    "examples": [
      {
        "description": "Vanguard Index Funds N-PORT filings",
        "input": {
          "cik": "0000036405",
          "limit": 4
        }
      },
      {
        "description": "Get recent 13F filings for an institution",
        "input": {
          "cik": "0001364742",
          "limit": 8
        }
      },
      {
        "description": "Track institutional portfolio changes",
        "input": {
          "cik": "0001350694"
        }
      }
    ],
    "form13fInfo": {
      "purpose": "Quarterly report of equity holdings by institutional investment managers",
      "whoMustFile": "Institutional investment managers with >$100M in assets under management",
      "filingDeadline": "Within 45 days after quarter end",
      "reportingRequirement": "Holdings of Section 13(f) securities (publicly traded US equities and certain derivatives)",
      "disclosure": [
        "Security name and class",
        "CUSIP number",
        "Number of shares",
        "Market value",
        "Investment discretion"
      ]
    },
    "institutionalManagers": {
      "berkshireHathaway": "0001067983",
      "vanguardGroup": "0001102694",
      "blackrock": "0001364742",
      "stateStreet": "0001350694",
      "fidelity": "0000315066"
    },
    "useCases": [
      "Track smart money (institutional investor activity)",
      "Monitor hedge fund holdings",
      "Identify popular institutional positions",
      "Analyze portfolio changes quarter-over-quarter",
      "Investment research and strategy",
      "Understand institutional sentiment"
    ]
  }
}
