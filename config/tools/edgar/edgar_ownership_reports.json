{
  "name": "edgar_ownership_reports",
  "implementation": "sajha.tools.impl.enhanced_edgar_tool.EDGAROwnershipReportsTool",
  "description": "Beneficial ownership reports (Schedule 13D for active, 13G for passive holders of more than 5%) in a company's EDGAR submissions. Since 18 December 2024 EDGAR names them SCHEDULE 13D / 13G (and /A), earlier SC 13D / SC 13G; either name finds both.\nReturns {cik, company_name, form_type, reports_count, reports: [{accessionNumber, filingDate, reportDate, form (as filed), primaryDocument, primaryDocDescription, document_url}]}, newest first.\nInputs (* required): cik*, form_type (default SC 13D), limit (default 20).\nSearches only the recent-filings block; amendments are separate form types.\nExample: {\"cik\": \"0000320193\", \"form_type\": \"SC 13G\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "cik": {
        "type": "string",
        "description": "Central Index Key"
      },
      "form_type": {
        "type": "string",
        "description": "Ownership form type",
        "enum": [
          "SC 13D",
          "SC 13G",
          "SC 13D/A",
          "SC 13G/A",
          "SCHEDULE 13D",
          "SCHEDULE 13G",
          "SCHEDULE 13D/A",
          "SCHEDULE 13G/A"
        ],
        "default": "SC 13D"
      },
      "limit": {
        "description": "Maximum reports to return (1-100)",
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      }
    },
    "required": [
      "cik"
    ],
    "examples": [{"cik": "0000320193", "form_type": "SC 13G"}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "cik": {
        "type": "string"
      },
      "company_name": {
        "type": "string"
      },
      "form_type": {
        "type": "string"
      },
      "reports_count": {
        "type": "integer"
      },
      "reports": {
        "type": "array"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "SEC EDGAR",
    "tags": [
      "sec",
      "edgar",
      "ownership",
      "13D",
      "13G",
      "activist"
    ],
    "rateLimit": 10,
    "cacheTTL": 1800
  }
}
