{
  "name": "edgar_companies_by_sic",
  "implementation": "sajha.tools.impl.enhanced_edgar_tool.EDGARCompaniesBySICTool",
  "description": "Companies in one industry by 4-digit SIC code, among the largest listed companies: reads the submissions file of each company in the SEC tickers list, largest market cap first, until limit matches or max_scan companies; smaller companies beyond max_scan are missed.\nReturns {sic_code, companies_count, companies_scanned, errors (files not read), companies: [{cik, name, sic, sicDescription, fiscalYearEnd}]}.\nInputs (* required): sic_code* (e.g. 7372 software, 3674 semiconductors, 6022 state banks), limit (default 50), max_scan (default 200; about 0.11 s each).\nFor one company's SIC, edgar_company_submissions is quicker.\nExample: {\"sic_code\": \"3674\", \"limit\": 5, \"max_scan\": 100}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "sic_code": {
        "type": "string",
        "description": "4-digit SIC code (e.g., '7372' for prepackaged software, '6022' for state commercial banks, '3674' for semiconductors)"
      },
      "limit": {
        "type": "integer",
        "description": "Maximum companies to return (1-500)",
        "minimum": 1,
        "maximum": 500,
        "default": 50
      },
      "max_scan": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "default": 200,
        "description": "How many of the largest listed companies to check (one SEC request each)"
      }
    },
    "required": [
      "sic_code"
    ],
    "examples": [{"sic_code": "3674", "limit": 5, "max_scan": 100}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "sic_code": {
        "type": "string",
        "description": "SIC code queried"
      },
      "companies_count": {
        "type": "integer",
        "description": "Number of companies in this industry"
      },
      "companies": {
        "type": "array",
        "description": "Companies in the specified SIC code",
        "items": {
          "type": "object",
          "properties": {
            "cik": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sic": {
              "type": "string"
            },
            "sicDescription": {
              "type": "string"
            },
            "fiscalYearEnd": {
              "type": "string"
            }
          }
        }
      },
      "companies_scanned": {
        "type": "integer"
      },
      "errors": {
        "type": "integer"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "SEC EDGAR",
    "tags": [
      "sec",
      "edgar",
      "sic",
      "industry",
      "sector",
      "classification"
    ],
    "rateLimit": 10,
    "cacheTTL": 7200,
    "note": "SIC codes classify companies by industry. Useful for peer analysis and sector research.",
    "examples": [
      {
        "description": "Find all software companies",
        "input": {
          "sic_code": "7372",
          "limit": 100
        }
      },
      {
        "description": "Find semiconductor companies",
        "input": {
          "sic_code": "3674"
        }
      },
      {
        "description": "Find commercial banks",
        "input": {
          "sic_code": "6022",
          "limit": 50
        }
      }
    ],
    "useCases": [
      "Industry peer group analysis",
      "Sector screening",
      "Competitive intelligence",
      "Market research",
      "Building industry indices"
    ],
    "commonSICCodes": {
      "technology": {
        "7370": "Computer Programming, Data Processing",
        "7372": "Prepackaged Software",
        "7373": "Computer Integrated Systems Design",
        "3674": "Semiconductors & Related Devices"
      },
      "finance": {
        "6022": "State Commercial Banks",
        "6211": "Security Brokers, Dealers & Flotation Companies",
        "6282": "Investment Advice"
      },
      "pharma": {
        "2834": "Pharmaceutical Preparations",
        "2835": "In Vitro & In Vivo Diagnostic Substances",
        "2836": "Biological Products"
      },
      "retail": {
        "5331": "Variety Stores",
        "5735": "Record & Prerecorded Tape Stores",
        "5961": "Catalog & Mail-Order Houses"
      }
    }
  }
}
