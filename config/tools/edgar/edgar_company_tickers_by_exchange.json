{
  "name": "edgar_company_tickers_by_exchange",
  "implementation": "sajha.tools.impl.enhanced_edgar_tool.EDGARCompanyTickersByExchangeTool",
  "description": "Companies listed on one stock exchange, from the SEC's company_tickers_exchange.json file (one row per ticker, in the SEC's market-capitalisation order).\nReturns {exchange, companies_count, companies: [{cik, ticker, title}]}.\nInputs (* required): exchange* (Nasdaq | NYSE | OTC | CBOE | TXSE, the values the SEC file uses), limit (integer 1-5000, default 100).\nFor one company use edgar_company_search.\nExample: {\"exchange\": \"NYSE\", \"limit\": 50}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "exchange": {
        "type": "string",
        "description": "Stock exchange code",
        "enum": [
          "Nasdaq",
          "NYSE",
          "OTC",
          "CBOE",
          "TXSE"
        ]
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of companies to return",
        "minimum": 1,
        "maximum": 5000,
        "default": 100
      }
    },
    "required": [
      "exchange"
    ],
    "examples": [{"exchange": "NYSE", "limit": 50}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "exchange": {
        "type": "string",
        "description": "Stock exchange queried"
      },
      "companies_count": {
        "type": "integer",
        "description": "Number of companies returned"
      },
      "companies": {
        "type": "array",
        "description": "List of companies on the exchange",
        "items": {
          "type": "object",
          "properties": {
            "cik": {
              "type": "string"
            },
            "ticker": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "SEC EDGAR",
    "tags": [
      "sec",
      "edgar",
      "exchange",
      "nyse",
      "nasdaq",
      "listings"
    ],
    "rateLimit": 10,
    "cacheTTL": 7200,
    "examples": [
      {
        "description": "Get all NYSE companies",
        "input": {
          "exchange": "NYSE",
          "limit": 500
        }
      },
      {
        "description": "Get NASDAQ listings",
        "input": {
          "exchange": "Nasdaq"
        }
      }
    ],
    "useCases": [
      "Exchange-specific company screening",
      "Market analysis by exchange",
      "Building exchange indices"
    ]
  }
}
