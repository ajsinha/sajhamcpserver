{
  "name": "fbi_get_state_statistics",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetStateStatisticsTool",
  "description": "Offense counts, rate per 100,000 and clearances for one US state and year, compared with the national rate",
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "description": "Two-letter USPS state code (e.g. CA, NY, TX, DC)",
        "pattern": "^[A-Za-z]{2}$"
      },
      "offense_type": {
        "type": "string",
        "description": "Offense (UCR summarized offense category)",
        "enum": [
          "violent_crime",
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "property_crime",
          "burglary",
          "larceny",
          "motor_vehicle_theft",
          "arson"
        ]
      },
      "year": {
        "type": "integer",
        "description": "Data year (defaults to last calendar year)",
        "minimum": 1985,
        "maximum": 2100
      },
      "include_monthly": {
        "type": "boolean",
        "description": "Also return the month-by-month series",
        "default": false
      }
    },
    "required": [
      "state",
      "offense_type"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string"
      },
      "state_name": {
        "type": "string"
      },
      "offense_type": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "state_data": {
        "type": "object",
        "properties": {
          "total_incidents": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Offenses reported in the year (sum of monthly counts)"
          },
          "total_cleared": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Offenses cleared in the year"
          },
          "clearance_rate_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "total_cleared / total_incidents x 100"
          },
          "rate_per_100k": {
            "type": [
              "number",
              "null"
            ],
            "description": "Offenses per 100,000 covered population (sum of the monthly rates)"
          },
          "population": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Total population of the jurisdiction"
          },
          "participated_population": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Average monthly population covered by reporting agencies"
          },
          "population_coverage_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Average monthly percent of population covered"
          },
          "months_reported": {
            "type": "integer",
            "description": "Months with data in the year"
          }
        }
      },
      "comparison": {
        "type": "object",
        "properties": {
          "national_rate_per_100k": {
            "type": [
              "number",
              "null"
            ]
          },
          "percent_of_national": {
            "type": [
              "number",
              "null"
            ],
            "description": "State rate as a percent of the national rate"
          }
        }
      },
      "monthly": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "description": "YYYY-MM"
            },
            "incidents": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rate_per_100k": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "state",
      "offense_type",
      "year",
      "state_data",
      "comparison"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "statistics",
      "state",
      "ucr"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Calls /summarized/state/{state}/{offense}.",
    "examples": [
      {
        "description": "California property crime, 2024",
        "input": {
          "state": "CA",
          "offense_type": "property_crime",
          "year": 2024
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
