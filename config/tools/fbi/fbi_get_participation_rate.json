{
  "name": "fbi_get_participation_rate",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetParticipationRateTool",
  "description": "Share of the population covered by agencies reporting crime data to the FBI, nationally or for one state, by month, from the FBI Crime Data Explorer.\nReturns: scope, state, year, participation_data (total_population, average_participated_population, average_population_coverage_pct, months_reported), monthly (month YYYY-MM, population_coverage_pct, participated_population) and metadata. Coverage is read from the violent-crime series.\nInputs (none required): state (two-letter USPS code; omit for national); year (1985 to the current year; default last year).\nUse it to judge how complete the figures from fbi_get_national_statistics or fbi_get_state_statistics are for a year.\nExample: {\"state\": \"FL\", \"year\": 2021}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "description": "Optional two-letter state code; omit for national",
        "pattern": "^[A-Za-z]{2}$"
      },
      "year": {
        "type": "integer",
        "description": "Data year (1985 to the current year; defaults to last calendar year)",
        "minimum": 1985
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "national",
          "state"
        ]
      },
      "state": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "participation_data": {
        "type": "object",
        "properties": {
          "total_population": {
            "type": [
              "integer",
              "null"
            ]
          },
          "average_participated_population": {
            "type": [
              "integer",
              "null"
            ]
          },
          "average_population_coverage_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "months_reported": {
            "type": "integer"
          }
        }
      },
      "monthly": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string"
            },
            "population_coverage_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "participated_population": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "scope",
      "year",
      "participation_data"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "participation",
      "reporting",
      "ucr"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "The CDE API no longer publishes agency counts by participation; coverage comes from the population fields of /summarized/{national | state/{state}}/V.",
    "examples": [
      {
        "description": "National coverage, 2024",
        "input": {
          "year": 2024
        }
      },
      {
        "description": "Florida coverage, 2021",
        "input": {
          "state": "FL",
          "year": 2021
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
