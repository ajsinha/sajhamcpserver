{
  "name": "fbi_get_agency_statistics",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetAgencyStatisticsTool",
  "description": "Offense counts, rate per 100,000 and clearances for one law enforcement agency (by ORI), compared with its state and the nation",
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "ori": {
        "type": "string",
        "description": "9-character agency ORI code (e.g. VT0040100); find one with fbi_search_agencies",
        "pattern": "^[A-Za-z0-9]{9}$"
      },
      "offense_type": {
        "type": "string",
        "description": "Offense (UCR summarized offense category)",
        "enum": [
          "violent_crime",
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "property_crime",
          "burglary",
          "larceny",
          "motor_vehicle_theft",
          "arson"
        ]
      },
      "year": {
        "type": "integer",
        "description": "Data year (defaults to last calendar year)",
        "minimum": 1985,
        "maximum": 2100
      }
    },
    "required": [
      "ori",
      "offense_type"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ori": {
        "type": "string"
      },
      "agency_name": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "offense_type": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "agency_data": {
        "type": "object",
        "properties": {
          "total_incidents": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Offenses reported in the year (sum of monthly counts)"
          },
          "total_cleared": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Offenses cleared in the year"
          },
          "clearance_rate_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "total_cleared / total_incidents x 100"
          },
          "rate_per_100k": {
            "type": [
              "number",
              "null"
            ],
            "description": "Offenses per 100,000 covered population (sum of the monthly rates)"
          },
          "population": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Total population of the jurisdiction"
          },
          "participated_population": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Average monthly population covered by reporting agencies"
          },
          "population_coverage_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Average monthly percent of population covered"
          },
          "months_reported": {
            "type": "integer",
            "description": "Months with data in the year"
          }
        }
      },
      "comparison": {
        "type": "object",
        "properties": {
          "state_rate_per_100k": {
            "type": [
              "number",
              "null"
            ]
          },
          "national_rate_per_100k": {
            "type": [
              "number",
              "null"
            ]
          },
          "percent_of_state": {
            "type": [
              "number",
              "null"
            ]
          },
          "percent_of_national": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "ori",
      "agency_name",
      "offense_type",
      "year",
      "agency_data",
      "comparison"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "agency",
      "police",
      "ucr"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Calls /summarized/agency/{ori}/{offense}.",
    "examples": [
      {
        "description": "Burlington (VT) Police Department violent crime, 2024",
        "input": {
          "ori": "VT0040100",
          "offense_type": "violent_crime",
          "year": 2024
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
