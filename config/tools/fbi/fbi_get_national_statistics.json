{
  "name": "fbi_get_national_statistics",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBIGetNationalStatisticsTool",
  "description": "Nationwide US offense counts, rate per 100,000, clearances and reporting coverage for one year, from the FBI Crime Data Explorer (UCR summarized data).\nReturns: offense_type, year, national_data (total_incidents, total_cleared, clearance_rate_pct, rate_per_100k, population, population_coverage_pct, months_reported, participated_population), optional monthly (month YYYY-MM, incidents, rate_per_100k) and metadata (endpoint, refresh dates).\nInputs (* required): offense_type* (a UCR category such as violent_crime, property_crime, homicide, robbery, burglary; list in the schema); year (1985 to the current year; default last year); include_monthly (boolean; default false).\nFor one state use fbi_get_state_statistics, for several years fbi_get_crime_trend, for victim and offender detail fbi_get_offense_data.\nExample: {\"offense_type\": \"violent_crime\", \"year\": 2023, \"include_monthly\": true}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string",
        "description": "Offense (UCR summarized offense category)",
        "enum": [
          "violent_crime",
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "property_crime",
          "burglary",
          "larceny",
          "motor_vehicle_theft",
          "arson"
        ]
      },
      "year": {
        "type": "integer",
        "description": "Data year (1985 to the current year; defaults to last calendar year)",
        "minimum": 1985
      },
      "include_monthly": {
        "type": "boolean",
        "description": "Also return the month-by-month series",
        "default": false
      }
    },
    "required": [
      "offense_type"
    ],
    "examples": [{"offense_type": "violent_crime", "year": 2023, "include_monthly": true}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "national_data": {
        "type": "object",
        "properties": {
          "total_incidents": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Offenses reported in the year (sum of monthly counts)"
          },
          "total_cleared": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Offenses cleared in the year"
          },
          "clearance_rate_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "total_cleared / total_incidents x 100"
          },
          "rate_per_100k": {
            "type": [
              "number",
              "null"
            ],
            "description": "Offenses per 100,000 covered population (sum of the monthly rates)"
          },
          "population": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Total population of the jurisdiction"
          },
          "participated_population": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Average monthly population covered by reporting agencies"
          },
          "population_coverage_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Average monthly percent of population covered"
          },
          "months_reported": {
            "type": "integer",
            "description": "Months with data in the year"
          }
        }
      },
      "monthly": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "description": "YYYY-MM"
            },
            "incidents": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rate_per_100k": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "offense_type",
      "year",
      "national_data",
      "metadata"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "statistics",
      "national",
      "ucr"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Calls /summarized/national/{offense}. Rates are per 100,000 people covered by reporting agencies.",
    "examples": [
      {
        "description": "National violent crime, 2024",
        "input": {
          "offense_type": "violent_crime",
          "year": 2024
        }
      },
      {
        "description": "Monthly homicides, 2023",
        "input": {
          "offense_type": "homicide",
          "year": 2023,
          "include_monthly": true
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
