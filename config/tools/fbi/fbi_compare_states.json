{
  "name": "fbi_compare_states",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBICompareStatesTool",
  "description": "Rank several US states on one offense for one year, with the national rate for reference",
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "states": {
        "type": "array",
        "description": "Two to ten two-letter state codes",
        "items": {
          "type": "string",
          "description": "Two-letter USPS state code (e.g. CA, NY, TX, DC)",
          "pattern": "^[A-Za-z]{2}$"
        },
        "minItems": 2,
        "maxItems": 10
      },
      "offense_type": {
        "type": "string",
        "description": "Offense (UCR summarized offense category)",
        "enum": [
          "violent_crime",
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "property_crime",
          "burglary",
          "larceny",
          "motor_vehicle_theft",
          "arson"
        ]
      },
      "year": {
        "type": "integer",
        "description": "Data year (defaults to last calendar year)",
        "minimum": 1985,
        "maximum": 2100
      },
      "per_capita": {
        "type": "boolean",
        "description": "Rank by rate per 100,000 (true) or by count (false)",
        "default": true
      },
      "include_national_average": {
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "states",
      "offense_type"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "comparison_type": {
        "type": "string",
        "enum": [
          "per_capita",
          "absolute"
        ]
      },
      "states_compared": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string"
            },
            "state_name": {
              "type": "string"
            },
            "total_incidents": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rate_per_100k": {
              "type": [
                "number",
                "null"
              ]
            },
            "state_population": {
              "type": [
                "integer",
                "null"
              ]
            },
            "population_coverage_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "percent_of_national": {
              "type": [
                "number",
                "null"
              ]
            },
            "rank": {
              "type": "integer"
            }
          }
        }
      },
      "comparison_summary": {
        "type": "object",
        "properties": {
          "highest_state": {
            "type": "string"
          },
          "lowest_state": {
            "type": "string"
          },
          "range": {
            "type": "number"
          },
          "average_of_compared": {
            "type": "number"
          }
        }
      },
      "national_reference": {
        "type": "object",
        "properties": {
          "rate_per_100k": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "errors": {
        "type": "object",
        "description": "States that could not be fetched, with the reason"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "offense_type",
      "year",
      "states_compared",
      "comparison_summary"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "comparison",
      "states",
      "ranking"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "One call to /summarized/state/{state}/{offense} per state.",
    "examples": [
      {
        "description": "Violent crime in the four largest states, 2024",
        "input": {
          "states": [
            "CA",
            "TX",
            "FL",
            "NY"
          ],
          "offense_type": "violent_crime",
          "year": 2024
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
