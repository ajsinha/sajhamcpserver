{
  "name": "fbi_compare_states",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBICompareStatesTool",
  "description": "Rank 2 to 10 US states on one offense for one year, from the FBI Crime Data Explorer.\nReturns: comparison_type, states_compared ranked highest first (rank, state, total_incidents, rate_per_100k, state_population, population_coverage_pct, percent_of_national), comparison_summary (highest_state, lowest_state, range, average_of_compared), national_reference, metadata, errors for states without data.\nInputs (* required): states* (2-10 two-letter codes); offense_type* (a UCR category such as violent_crime, property_crime, homicide, robbery, burglary; list in the schema); year (1985 to the current year; default last year); per_capita (rank by rate per 100,000 if true, by count if false; default true); include_national_average (boolean; default true).\nFor one state in detail use fbi_get_state_statistics.\nExample: {\"states\": [\"CA\", \"TX\", \"NY\", \"FL\"], \"offense_type\": \"motor_vehicle_theft\", \"year\": 2023}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "states": {
        "type": "array",
        "description": "Two to ten two-letter state codes",
        "items": {
          "type": "string",
          "description": "Two-letter USPS state code (e.g. CA, NY, TX, DC)",
          "pattern": "^[A-Za-z]{2}$"
        },
        "minItems": 2,
        "maxItems": 10
      },
      "offense_type": {
        "type": "string",
        "description": "Offense (UCR summarized offense category)",
        "enum": [
          "violent_crime",
          "homicide",
          "rape",
          "robbery",
          "aggravated_assault",
          "property_crime",
          "burglary",
          "larceny",
          "motor_vehicle_theft",
          "arson"
        ]
      },
      "year": {
        "type": "integer",
        "description": "Data year (1985 to the current year; defaults to last calendar year)",
        "minimum": 1985
      },
      "per_capita": {
        "type": "boolean",
        "description": "Rank by rate per 100,000 (true) or by count (false)",
        "default": true
      },
      "include_national_average": {
        "type": "boolean",
        "description": "Add national_reference with the national rate per 100,000 (default true)",
        "default": true
      }
    },
    "required": [
      "states",
      "offense_type"
    ],
    "examples": [{"states": ["CA", "TX", "NY", "FL"], "offense_type": "motor_vehicle_theft", "year": 2023}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "offense_type": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "comparison_type": {
        "type": "string",
        "enum": [
          "per_capita",
          "absolute"
        ]
      },
      "states_compared": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string"
            },
            "state_name": {
              "type": "string"
            },
            "total_incidents": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rate_per_100k": {
              "type": [
                "number",
                "null"
              ]
            },
            "state_population": {
              "type": [
                "integer",
                "null"
              ]
            },
            "population_coverage_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "percent_of_national": {
              "type": [
                "number",
                "null"
              ]
            },
            "rank": {
              "type": "integer"
            }
          }
        }
      },
      "comparison_summary": {
        "type": "object",
        "properties": {
          "highest_state": {
            "type": "string"
          },
          "lowest_state": {
            "type": "string"
          },
          "range": {
            "type": "number"
          },
          "average_of_compared": {
            "type": "number"
          }
        }
      },
      "national_reference": {
        "type": "object",
        "properties": {
          "rate_per_100k": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "errors": {
        "type": "object",
        "description": "States that could not be fetched, with the reason"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "data_source": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "description": "CDE API path called"
          },
          "data_last_refreshed": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_available_through": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "offense_type",
      "year",
      "states_compared",
      "comparison_summary"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "comparison",
      "states",
      "ranking"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "One call to /summarized/state/{state}/{offense} per state.",
    "examples": [
      {
        "description": "Violent crime in the four largest states, 2024",
        "input": {
          "states": [
            "CA",
            "TX",
            "FL",
            "NY"
          ],
          "offense_type": "violent_crime",
          "year": 2024
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
