{
  "name": "fbi_search_agencies",
  "implementation": "sajha.tools.impl.fbi_tool_refactored.FBISearchAgenciesTool",
  "description": "List or search the law enforcement agencies in one US state to find their ORI codes, from the FBI Crime Data Explorer agency directory.\nReturns: state, search_query, total_results (all matches) and agencies sorted by name (ori, agency_name, agency_type, county, state_name, is_nibrs, nibrs_start_date, latitude, longitude), cut to limit.\nInputs (* required): state* (two-letter USPS code); agency_name (case-insensitive substring, e.g. police, sheriff; omit to list all); county (case-insensitive substring); agency_type (city, county, state, university, tribal, other or all; default all; state = State Police and Other State Agency); limit (1-500; default 20).\nThe ORI feeds fbi_get_agency_statistics, fbi_get_agency_details and fbi_get_crime_trend.\nExample: {\"state\": \"VT\", \"agency_name\": \"police\", \"limit\": 10}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "3.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "description": "Two-letter USPS state code (e.g. CA, NY, TX, DC)",
        "pattern": "^[A-Za-z]{2}$"
      },
      "agency_name": {
        "type": "string",
        "description": "Case-insensitive substring of the agency name (e.g. 'police', 'sheriff'); omit to list all"
      },
      "county": {
        "type": "string",
        "description": "Case-insensitive substring of the county name"
      },
      "agency_type": {
        "type": "string",
        "description": "Agency type filter ('state' = State Police and Other State Agency)",
        "enum": [
          "city",
          "county",
          "state",
          "university",
          "tribal",
          "other",
          "all"
        ],
        "default": "all"
      },
      "limit": {
        "type": "integer",
        "description": "Maximum agencies returned",
        "minimum": 1,
        "maximum": 500,
        "default": 20
      }
    },
    "required": [
      "state"
    ],
    "examples": [{"state": "VT", "agency_name": "police", "limit": 10}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string"
      },
      "search_query": {
        "type": "string"
      },
      "total_results": {
        "type": "integer",
        "description": "Matches before the limit is applied"
      },
      "agencies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ori": {
              "type": "string"
            },
            "agency_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "agency_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "county": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": "string"
            },
            "state_name": {
              "type": "string"
            },
            "is_nibrs": {
              "type": "boolean"
            },
            "nibrs_start_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "latitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "longitude": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "ori",
            "agency_name",
            "state"
          ]
        }
      }
    },
    "required": [
      "state",
      "search_query",
      "total_results",
      "agencies"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Crime Statistics",
    "tags": [
      "crime",
      "fbi",
      "agency",
      "search",
      "ori"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Calls /agency/byStateAbbr/{state} and filters locally; the API has no free-text or nationwide agency search.",
    "examples": [
      {
        "description": "Police departments in Vermont",
        "input": {
          "state": "VT",
          "agency_name": "police",
          "limit": 10
        }
      },
      {
        "description": "Sheriffs in Los Angeles County",
        "input": {
          "state": "CA",
          "county": "los angeles",
          "agency_type": "county"
        }
      }
    ]
  },
  "api_key": "${fbi.api.key:}"
}
