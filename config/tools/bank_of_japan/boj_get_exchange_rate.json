{
  "name": "boj_get_exchange_rate",
  "implementation": "sajha.tools.impl.japan_central_bank.BoJGetExchangeRateTool",
  "description": "Daily yen exchange rates from FRED (Federal Reserve Bank of St. Louis): usd_jpy is yen per US dollar (DEXJPUS); eur_jpy is yen per euro, derived as DEXJPUS x DEXUSEU on matching dates.\nReturns: series_code (FRED id), series_id, label, source, observation_count and observations (date, value) oldest first, missing values dropped (eur_jpy also carries units and a derived-rate source).\nInputs (* required): currency_pair* (usd_jpy or eur_jpy; schema default usd_jpy); start_date, end_date (YYYY-MM-DD); recent_periods (1-100; the last N observations, with no dates looking back N x 45 days; when omitted the whole history in the date range is returned).\nFor euro reference rates use ecb_get_exchange_rate with EUR/JPY. Needs a FRED API key (FRED_API_KEY, config fred.api.key); without one the call fails with a message saying so.\nExample: {\"currency_pair\": \"usd_jpy\", \"recent_periods\": 30}",
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "currency_pair": {
        "type": "string",
        "description": "Currency pair (foreign currency per JPY)",
        "enum": [
          "usd_jpy",
          "eur_jpy"
        ],
        "default": "usd_jpy"
      },
      "start_date": {
        "type": "string",
        "description": "Start date in YYYY-MM-DD format"
      },
      "end_date": {
        "type": "string",
        "description": "End date in YYYY-MM-DD format"
      },
      "recent_periods": {
        "type": "integer",
        "description": "Number of recent observations (1-100)",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      }
    },
    "required": [
      "currency_pair"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "series_code": {
        "type": "string",
        "description": "Exchange rate series code"
      },
      "label": {
        "type": "string",
        "description": "Currency pair description"
      },
      "observation_count": {
        "type": "integer",
        "description": "Number of observations returned"
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Date of observation"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Exchange rate value"
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Foreign Exchange",
    "tags": [
      "forex",
      "exchange rates",
      "jpy",
      "japan",
      "currency"
    ],
    "rateLimit": 120,
    "cacheTTL": 1800,
    "examples": [
      {
        "description": "Get latest USD/JPY rate",
        "input": {
          "currency_pair": "usd_jpy",
          "recent_periods": 1
        }
      }
    ]
  },
  "api_key": "${fred.api.key}"
}
