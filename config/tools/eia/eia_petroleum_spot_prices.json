{
  "name": "eia_petroleum_spot_prices",
  "implementation": "sajha.tools.impl.eia_tools.EiaPetroleumSpotPricesTool",
  "description": "Crude oil and petroleum product spot prices (WTI, Brent, gasoline, diesel, heating oil, jet fuel, propane), in dollars per barrel or per gallon.\nReturns: source, route, frequency, series (series_id, name, label, unit, observations date/value).\nInputs (* required): products (default wti, brent), frequency (daily, weekly, monthly, annual; default daily), period (default last 30 days).\nExample: {\"products\": [\"wti\", \"brent\"], \"period\": \"last 30 days\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 3600,
  "api_key": "${EIA_API_KEY:}",
  "inputSchema": {
    "type": "object",
    "properties": {
      "products": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "wti",
            "brent",
            "ny_harbor_gasoline",
            "gulf_coast_gasoline",
            "los_angeles_rbob",
            "ny_harbor_heating_oil",
            "ny_harbor_ulsd",
            "gulf_coast_ulsd",
            "los_angeles_carb_diesel",
            "gulf_coast_jet_fuel",
            "mont_belvieu_propane"
          ]
        },
        "minItems": 1,
        "maxItems": 11,
        "uniqueItems": true,
        "default": [
          "wti",
          "brent"
        ],
        "description": "Products and hubs"
      },
      "frequency": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly",
          "annual"
        ],
        "default": "daily",
        "description": "Price frequency"
      },
      "period": {
        "type": "string",
        "default": "last 30 days",
        "description": "2025, 2025-Q3, 2025-07, 'last N months|quarters|years' or YYYY-MM-DD:YYYY-MM-DD"
      }
    },
    "required": [],
    "additionalProperties": false,
    "examples": [
      {
        "products": [
          "wti",
          "brent"
        ],
        "period": "last 30 days"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "source": {
        "type": "string",
        "description": "Source: U.S. Energy Information Administration ...; cite it with the data"
      },
      "note": {
        "type": "string",
        "description": "Why the DEMO_KEY was used"
      },
      "route": {
        "type": "string",
        "description": "EIA route read"
      },
      "frequency": {
        "type": "string",
        "description": "daily, weekly, monthly, quarterly or annual"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "truncated": {
        "type": "boolean",
        "description": "More rows matched than were returned"
      },
      "series_count": {
        "type": "integer",
        "description": "Series returned"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "series_id",
            "observations"
          ],
          "properties": {
            "series_id": {
              "type": "string",
              "description": "EIA series id"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "The name asked for"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "description": "EIA series description"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. $/BBL, MBBL thousand barrels, BCF)"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "value"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM-DD, YYYY-MM or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  },
                  "change": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Change from the previous week (storage: injection + or withdrawal -)"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "eia",
      "oil",
      "spot prices",
      "energy"
    ]
  }
}
