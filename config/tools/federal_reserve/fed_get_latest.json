{
  "name": "fed_get_latest",
  "implementation": "sajha.tools.impl.fed_reserve_tool_refactored.FedGetLatestTool",
  "description": "The newest observation that has a value for one FRED series (Federal Reserve Bank of St. Louis), by series id or shorthand.\nReturns: series_id, title, units, frequency, date, value and last_updated; an error if none of the last 10 observations has a value.\nInputs: series_id (e.g. DGS10, UNRATE; wins over indicator) or indicator (gdp, unemployment, inflation (CPIAUCSL index), fed_rate, treasury_10y, treasury_2y, sp500, housing, retail, industrial, m2, pce); one is needed.\nFor history use fed_get_series; for several at once fed_get_common_indicators.\nExample: {\"series_id\": \"DGS10\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "api_key": "${fred.api.key}",
  "inputSchema": {
    "type": "object",
    "properties": {
      "series_id": {
        "type": "string",
        "description": "FRED series ID (e.g., 'GDP', 'UNRATE', 'DGS10')"
      },
      "indicator": {
        "type": "string",
        "description": "Common indicator shorthand name",
        "enum": ["gdp", "unemployment", "inflation", "fed_rate", "treasury_10y", "treasury_2y", "sp500", "housing", "retail", "industrial", "m2", "pce"]
      }
    },
    "oneOf": [
      {"required": ["series_id"]},
      {"required": ["indicator"]}
    ],
    "examples": [{"series_id": "DGS10"}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "series_id": {
        "type": "string",
        "description": "FRED series identifier"
      },
      "title": {
        "type": "string",
        "description": "Series title"
      },
      "units": {
        "type": "string",
        "description": "Units of measurement"
      },
      "frequency": {
        "type": "string",
        "description": "Data frequency"
      },
      "date": {
        "type": "string",
        "description": "Date of latest observation"
      },
      "value": {
        "type": ["number", "null"],
        "description": "Latest observation value"
      },
      "last_updated": {
        "type": "string",
        "description": "When the series was last updated"
      }
    },
    "required": ["series_id", "title", "date", "value"]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": ["fred", "federal reserve", "economic data", "latest", "current data"],
    "rateLimit": 120,
    "cacheTTL": 1800,
    "note": "Quick access to the most recent value of any FRED series. Ideal for dashboards and real-time monitoring.",
    "examples": [
      {
        "description": "Get current unemployment rate",
        "input": {
          "indicator": "unemployment"
        }
      },
      {
        "description": "Get latest Fed funds rate",
        "input": {
          "indicator": "fed_rate"
        }
      },
      {
        "description": "Get current 10-year treasury yield",
        "input": {
          "series_id": "DGS10"
        }
      }
    ],
    "useCases": [
      "Real-time economic monitoring",
      "Dashboard displays",
      "Quick fact checking",
      "Market analysis",
      "Economic alerts"
    ]
  }
}
