{
  "name": "fed_get_series",
  "implementation": "sajha.tools.impl.fed_reserve_tool_refactored.FedGetSeriesTool",
  "description": "Observations of one FRED series (Federal Reserve Bank of St. Louis), by series id or shorthand.\nReturns: series_id, title, units, frequency, last_updated, observation_count and observations (date, value; null where FRED has none) oldest first.\nInputs: series_id (FRED id such as GDP, UNRATE, DGS10; wins over indicator) or indicator (gdp, unemployment, inflation (CPIAUCSL index), fed_rate, treasury_10y, treasury_2y, sp500, housing, retail, industrial, m2, pce); one is needed; start_date, end_date (YYYY-MM-DD); limit (1-1000; default 100; counted from the start, so set start_date for recent data).\nFind ids with fed_search_series; for one value use fed_get_latest.\nExample: {\"indicator\": \"unemployment\", \"start_date\": \"2020-01-01\", \"end_date\": \"2024-12-31\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "api_key": "${fred.api.key}",
  "inputSchema": {
    "type": "object",
    "properties": {
      "series_id": {
        "type": "string",
        "description": "FRED series ID (e.g., 'GDP', 'UNRATE', 'DGS10'). Use this for direct series access."
      },
      "indicator": {
        "type": "string",
        "description": "Common indicator shorthand name for convenience",
        "enum": ["gdp", "unemployment", "inflation", "fed_rate", "treasury_10y", "treasury_2y", "sp500", "housing", "retail", "industrial", "m2", "pce"]
      },
      "start_date": {
        "type": "string",
        "description": "Start date in YYYY-MM-DD format"
      },
      "end_date": {
        "type": "string",
        "description": "End date in YYYY-MM-DD format"
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of observations to return",
        "default": 100,
        "minimum": 1,
        "maximum": 1000
      }
    },
    "oneOf": [
      {"required": ["series_id"]},
      {"required": ["indicator"]}
    ],
    "examples": [{"indicator": "unemployment", "start_date": "2020-01-01", "end_date": "2024-12-31"}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "series_id": {
        "type": "string",
        "description": "FRED series identifier"
      },
      "title": {
        "type": "string",
        "description": "Series title/name"
      },
      "units": {
        "type": "string",
        "description": "Units of measurement"
      },
      "frequency": {
        "type": "string",
        "description": "Data frequency (Daily, Monthly, Quarterly, Annual)"
      },
      "last_updated": {
        "type": "string",
        "description": "When the series was last updated"
      },
      "observation_count": {
        "type": "integer",
        "description": "Number of observations returned"
      },
      "observations": {
        "type": "array",
        "description": "Time series observations",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Observation date (YYYY-MM-DD)"
            },
            "value": {
              "type": ["number", "null"],
              "description": "Observation value (null if not available)"
            }
          },
          "required": ["date", "value"]
        }
      }
    },
    "required": ["series_id", "title", "observations"]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": ["fred", "federal reserve", "economic data", "us economy", "time series"],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Access to Federal Reserve Economic Data (FRED) - the premier source for US economic data. Requires FRED API key for production use.",
    "examples": [
      {
        "description": "Get latest year of GDP data",
        "input": {
          "indicator": "gdp",
          "limit": 4
        }
      },
      {
        "description": "Get unemployment rate for 2024",
        "input": {
          "series_id": "UNRATE",
          "start_date": "2024-01-01",
          "end_date": "2024-12-31"
        }
      },
      {
        "description": "Get 10-year treasury yield history",
        "input": {
          "indicator": "treasury_10y",
          "start_date": "2023-01-01",
          "limit": 250
        }
      }
    ],
    "useCases": [
      "Economic research and analysis",
      "Financial modeling",
      "Investment analysis",
      "Policy research",
      "Academic studies",
      "Market forecasting"
    ]
  }
}
