{
  "name": "research_get_work",
  "implementation": "sajha.tools.impl.research_tools.ResearchGetWorkTool",
  "title": "Scholarly work (OpenAlex)",
  "description": "One scholarly work from OpenAlex by DOI or OpenAlex id, with its abstract, topics, citation count and open access link.\nReturns: work (id, doi, title, publication_year, publication_date, type, venue, publisher, authors, author_count, cited_by_count, open_access, open_access_url, landing_page, abstract, topics, referenced_works_count, language, is_retracted), budget.\nInputs: id (a DOI such as 10.1016/j.jbankfin.2006.07.013, a doi.org URL, or an OpenAlex id such as W3123092007).\nExample: {\"id\": \"10.1016/j.jbankfin.2006.07.013\"}",
  "annotations": {
    "title": "Scholarly work (OpenAlex)",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 86400,
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "DOI, doi.org URL, or OpenAlex work id (W...)",
        "minLength": 3,
        "maxLength": 300
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "id": "10.1016/j.jbankfin.2006.07.013"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "work": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "author_count": {
            "type": "integer"
          },
          "cited_by_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "open_access": {
            "type": "boolean"
          },
          "open_access_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "landing_page": {
            "type": [
              "string",
              "null"
            ]
          },
          "abstract": {
            "type": [
              "string",
              "null"
            ]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "referenced_works_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_retracted": {
            "type": "boolean"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "title"
        ]
      },
      "budget": {
        "type": "object",
        "properties": {
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "remaining_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "keyed": {
            "type": "boolean"
          }
        },
        "required": []
      },
      "source": {
        "type": "string",
        "description": "Attribution"
      }
    },
    "required": [
      "work",
      "source"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Research",
    "tags": [
      "openalex",
      "doi",
      "scholarly works"
    ]
  }
}
