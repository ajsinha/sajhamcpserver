{
  "name": "ust_average_interest_rates",
  "implementation": "sajha.tools.impl.us_treasury_tools.UstAverageInterestRatesTool",
  "title": "Average interest rates on Treasury securities",
  "description": "Average interest rates on outstanding US Treasury securities by security (bills, notes, bonds, TIPS, FRNs and non-marketable series), monthly, in percent.\nReturns: units, count, truncated, records (date, security_type, security, average_interest_rate) oldest first.\nInputs (none required): period (2025, 2025-Q3, 2025-07 or \"last 12 months\"; default the latest month); security_type (filter, e.g. Marketable or Treasury Notes).\nExample: {\"period\": \"last 6 months\", \"security_type\": \"Treasury Notes\"}",
  "annotations": {
    "title": "Average interest rates on Treasury securities",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "period": {
        "type": "string",
        "description": "2025, 2025-Q3, 2025-07, 2025-01-01:2025-06-30 or \"last 12 months\""
      },
      "security_type": {
        "type": "string",
        "description": "Keep rows whose type (Marketable, Non-marketable) or security (Treasury Bills, TIPS) contains this text"
      }
    },
    "required": [],
    "additionalProperties": false,
    "examples": [
      {
        "period": "last 6 months",
        "security_type": "Treasury Notes"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "units": {
        "type": "string"
      },
      "count": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "records": {
        "type": "array",
        "description": "Oldest first",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "security_type": {
              "type": "string"
            },
            "security": {
              "type": "string"
            },
            "average_interest_rate": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "date"
          ]
        }
      },
      "source": {
        "type": "string",
        "description": "Attribution"
      }
    },
    "required": [
      "records",
      "source"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Fiscal Data",
    "tags": [
      "treasury",
      "interest rates",
      "cost of debt"
    ]
  }
}
