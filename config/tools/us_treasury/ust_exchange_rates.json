{
  "name": "ust_exchange_rates",
  "implementation": "sajha.tools.impl.us_treasury_tools.UstExchangeRatesTool",
  "title": "Treasury reporting rates of exchange",
  "description": "Treasury reporting rates of exchange: foreign currency units per US dollar, set quarterly for US government accounting.\nReturns: units, count, truncated, rates (date, effective_date, country, currency, country_currency, units_per_usd) oldest first.\nInputs: country (ISO 3166 code or name; EA for the euro area) or currency (ISO 4217 code such as EUR, or a name such as Euro), one of them; period (default the latest quarter).\nFor market rates use the central bank tools.\nExample: {\"currency\": \"EUR\", \"period\": \"last 12 months\"}",
  "annotations": {
    "title": "Treasury reporting rates of exchange",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "country": {
        "type": "string",
        "description": "Country: ISO 3166 code (CA, JP, EA) or name (Canada)"
      },
      "currency": {
        "type": "string",
        "description": "Currency: ISO 4217 code (EUR, JPY) or Treasury's name (Euro, Yen)"
      },
      "period": {
        "type": "string",
        "description": "2025, 2025-Q3, 2025-07, 2025-01-01:2025-06-30 or \"last 12 months\""
      }
    },
    "required": [],
    "additionalProperties": false,
    "examples": [
      {
        "currency": "EUR",
        "period": "last 12 months"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "units": {
        "type": "string"
      },
      "count": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "rates": {
        "type": "array",
        "description": "Oldest first",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "effective_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "country": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "country_currency": {
              "type": "string"
            },
            "units_per_usd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "date"
          ]
        }
      },
      "source": {
        "type": "string",
        "description": "Attribution"
      }
    },
    "required": [
      "rates",
      "source"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Fiscal Data",
    "tags": [
      "treasury",
      "exchange rates",
      "fx"
    ]
  }
}
