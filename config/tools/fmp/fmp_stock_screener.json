{
  "name": "fmp_stock_screener",
  "implementation": "sajha.tools.impl.fmp_tools.FMPStockScreenerTool",
  "description": "Screens listed stocks by market cap, price, beta, volume, dividend, sector, industry, country and exchange (FMP /stable/stock-screener).\nReturns {criteria (the filters sent), results_count, results (matching companies)}.\nInputs (* required): none. marketCapMoreThan/LowerThan (USD), priceMoreThan/LowerThan, betaMoreThan/LowerThan, volumeMoreThan (shares), dividendMoreThan, sector, industry, country (code, e.g. US), exchange (e.g. NASDAQ), limit (20 is sent when no filter is given).\nValid values: fmp_available_sectors, fmp_available_industries, fmp_available_countries, fmp_available_exchanges.\nExample: {\"sector\": \"Technology\", \"marketCapMoreThan\": 10000000000, \"exchange\": \"NASDAQ\", \"limit\": 25}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "4.5.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "marketCapMoreThan": {
        "type": "integer",
        "description": "Minimum market cap in USD"
      },
      "marketCapLowerThan": {
        "type": "integer",
        "description": "Maximum market cap in USD"
      },
      "sector": {
        "type": "string",
        "description": "Sector filter (e.g., Technology, Healthcare, Financial Services)"
      },
      "industry": {
        "type": "string",
        "description": "Industry filter"
      },
      "country": {
        "type": "string",
        "description": "Country filter (e.g., US, GB, JP)"
      },
      "exchange": {
        "type": "string",
        "description": "Exchange (e.g., NYSE, NASDAQ)"
      },
      "dividendMoreThan": {
        "type": "number",
        "description": "Minimum dividend yield"
      },
      "betaMoreThan": {
        "type": "number",
        "description": "Minimum beta"
      },
      "betaLowerThan": {
        "type": "number",
        "description": "Maximum beta"
      },
      "priceMoreThan": {
        "type": "number",
        "description": "Minimum price"
      },
      "priceLowerThan": {
        "type": "number",
        "description": "Maximum price"
      },
      "volumeMoreThan": {
        "type": "integer",
        "description": "Minimum daily volume"
      },
      "limit": {
        "type": "integer",
        "description": "Max results",
        "default": 20
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "criteria": {
        "type": "object"
      },
      "results_count": {
        "type": "integer"
      },
      "results": {
        "type": "array"
      }
    },
    "required": [
      "results_count",
      "results"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "email": "ajsinha@gmail.com",
    "copyright": "Copyright All rights Reserved 2025-2030, Ashutosh Sinha",
    "category": "Stock Screening",
    "tags": [
      "fmp",
      "screener",
      "filter",
      "scan",
      "stocks"
    ],
    "examples": [
      {
        "description": "Large-cap tech stocks",
        "input": {
          "sector": "Technology",
          "marketCapMoreThan": 100000000000,
          "limit": 10
        }
      },
      {
        "description": "High-dividend US stocks",
        "input": {
          "country": "US",
          "dividendMoreThan": 4,
          "limit": 20
        }
      }
    ]
  },
  "api_key": "${fmp.api.key}"
}