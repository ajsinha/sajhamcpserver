{
  "name": "ir_get_annual_reports",
  "implementation": "sajha.tools.impl.investor_relations_tool_refactored.IRGetAnnualReportsTool",
  "description": "Annual reports of a supported company (from its investor relations site, or 10-K/20-F filings from SEC EDGAR as a fallback).\nReturns {ticker, count, annual_reports: [{title, url, type, year, quarter, date, description, ticker, is_pdf, context}], success}, most recent first.\nInputs (* required): ticker* (string, stock symbol such as AAPL or MSFT; case-insensitive), year (integer 2000-2030, optional filter), limit (integer 1-20, default 5).\nOnly tickers in SAJHA's built-in company list work (ir_list_supported_companies); others fail with 'not supported'. For 10-K filings of any SEC registrant use edgar_filings_by_form.\nExample: {\"ticker\": \"AAPL\", \"limit\": 3}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "ticker": {
        "type": "string",
        "description": "Stock ticker symbol"
      },
      "year": {
        "type": "integer",
        "description": "Filter by specific year (optional)",
        "minimum": 2000,
        "maximum": 2030
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of reports to return",
        "default": 5,
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": ["ticker"],
    "examples": [{"ticker": "AAPL", "limit": 3}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ticker": {"type": "string"},
      "year": {"type": ["integer", "null"]},
      "count": {"type": "integer"},
      "annual_reports": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "url": {"type": "string"},
            "year": {"type": "integer"},
            "date": {"type": "string"}
          }
        }
      },
      "success": {"type": "boolean"}
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Financial Analysis",
    "tags": ["annual reports", "10-K", "financial statements"],
    "rateLimit": 30,
    "cacheTTL": 86400,
    "supported_companies": ["TSLA", "MSFT", "C", "BMO", "RY", "JPM", "GS"],
    "examples": [
      {
        "description": "Get Goldman Sachs annual reports",
        "input": {
          "ticker": "GS",
          "limit": 5
        }
      },
      {
        "description": "Get Royal Bank of Canada 2023 annual report",
        "input": {
          "ticker": "RY",
          "year": 2023
        }
      }
    ],
    "useCases": [
      "Annual financial analysis",
      "Historical performance research",
      "Access to 10-K filings"
    ]
  }
}
