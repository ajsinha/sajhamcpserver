{
    "name": "sharepoint_documents",
    "description": "Files in the configured SharePoint site's default document library, via Microsoft Graph.\nReturns a per-operation object with success, or {success: false, error}.\nInputs (* required): operation* (default list_files). list_files: folder_path, recursive. get_file, download (return_content: base64), get_metadata, get_versions, check_out: file_url. upload: file_name, content_base64 (up to 4 MB), folder_path, overwrite. search: query, folder_path, file_types, max_results. update_metadata: file_url, metadata. check_in: file_url, comment, publish. delete: file_url, recycle (default true). move, copy: source_url, destination_url, overwrite. Paths are library-relative (/Project/a.docx) or server-relative.\nSite search: sharepoint_search.\nExample: {\"operation\": \"list_files\", \"folder_path\": \"/Reports\"}\nNeeds SHAREPOINT_SITE_URL, AZURE_TENANT_ID, SHAREPOINT_CLIENT_ID, SHAREPOINT_CLIENT_SECRET (Entra ID app); unset, it answers 'SharePoint is not configured'.",
    "category": "Document Management",
    "version": "2.9.8",
    "enabled": true,
    "implementation": "sajha.tools.impl.sharepoint_tool.SharePointDocumentTool",
    "site_url": "${sharepoint.site.url}",
    "authentication": {
        "type": "client_credentials",
        "tenant_id": "${azure.tenant.id}",
        "client_id": "${sharepoint.client.id}",
        "client_secret": "${sharepoint.client.secret}"
    },
    "inputSchema": {
        "type": "object",
        "properties": {
            "operation": {
                "type": "string",
                "enum": [
                    "list_files",
                    "get_file",
                    "download",
                    "upload",
                    "search",
                    "get_metadata",
                    "update_metadata",
                    "check_out",
                    "check_in",
                    "get_versions",
                    "delete",
                    "move",
                    "copy"
                ],
                "description": "Document operation to perform",
                "default": "list_files"
            },
            "folder_path": {
                "type": "string",
                "description": "Folder in the site's default document library: library-relative (/Project) or server-relative (/sites/team/Shared Documents/Project)"
            },
            "file_url": {
                "type": "string",
                "description": "File path: library-relative (/Project/plan.docx) or server-relative (/sites/team/Shared Documents/Project/plan.docx)"
            },
            "file_name": {
                "type": "string",
                "description": "File name for upload"
            },
            "content_base64": {
                "type": "string",
                "description": "Base64-encoded file content for upload"
            },
            "query": {
                "type": "string",
                "description": "Search query text"
            },
            "metadata": {
                "type": "object",
                "description": "Metadata fields to update"
            },
            "destination_url": {
                "type": "string",
                "description": "Destination file path for move/copy (same forms as file_url)"
            },
            "overwrite": {
                "type": "boolean",
                "default": false,
                "description": "upload, move, copy: replace an existing file"
            },
            "recursive": {
                "type": "boolean",
                "default": false,
                "description": "list_files: include subfolders (at most 1000 items)"
            },
            "source_url": {
                "type": "string",
                "description": "move, copy: the source file (file_url is accepted too)"
            },
            "return_content": {
                "type": "boolean",
                "default": false,
                "description": "download: include the content as base64"
            },
            "comment": {
                "type": "string",
                "description": "check_in: the check-in comment"
            },
            "publish": {
                "type": "boolean",
                "default": false,
                "description": "check_in: publish a major version"
            },
            "recycle": {
                "type": "boolean",
                "default": true,
                "description": "delete: send to the recycle bin (false: delete permanently)"
            },
            "file_types": {
                "type": "array",
                "items": {
                    "type": "string",
                    "pattern": "^\\.?[A-Za-z0-9]{1,10}$"
                },
                "description": "search: keep only these extensions (e.g. ['docx', 'pdf'])"
            },
            "max_results": {
                "type": "integer",
                "default": 50,
                "minimum": 1,
                "maximum": 500,
                "description": "search: maximum results"
            }
        },
        "required": [
            "operation"
        ]
    },
    "outputSchema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean"
            },
            "files": {
                "type": "array"
            },
            "file_url": {
                "type": "string"
            },
            "metadata": {
                "type": "object"
            },
            "versions": {
                "type": "array"
            },
            "results": {
                "type": "array"
            },
            "execution_time_ms": {
                "type": "number"
            },
            "error": {
                "type": "string"
            }
        }
    },
    "metadata": {
        "author": "Ashutosh Sinha",
        "category": "Document Management",
        "tags": [
            "sharepoint",
            "documents",
            "microsoft",
            "ecm",
            "office365"
        ],
        "rateLimit": 100,
        "cacheTTL": 300,
        "examples": [
            {
                "description": "List files in folder",
                "input": {
                    "operation": "list_files",
                    "folder_path": "/Shared Documents"
                }
            },
            {
                "description": "Search documents",
                "input": {
                    "operation": "search",
                    "query": "project report 2024"
                }
            },
            {
                "description": "Get file metadata",
                "input": {
                    "operation": "get_metadata",
                    "file_url": "/sites/team/Shared Documents/report.docx"
                }
            }
        ]
    }
}
