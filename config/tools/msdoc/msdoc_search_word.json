{
  "name": "msdoc_search_word",
  "implementation": "sajha.tools.impl.msdoc_tools_tool_refactored.MsDocSearchWordTool",
  "description": "Searches the paragraphs of a Word document (.docx) for a case-insensitive substring; tables are not searched. Files are looked up by name in the docs folder (data/msdocs; msdoc_list_files shows it). Needs the python-docx package (optional in requirements.txt).\nReturns {filename, search_term, matches, match_count}: each match is {paragraph_index, text}.\nInputs (* required): filename*, search_term*.\nFor the whole document use msdoc_read_word; for spreadsheets msdoc_search_excel.\nExample: {\"filename\": \"report.docx\", \"search_term\": \"revenue\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": false},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "filename": {
        "type": "string",
        "description": "Name of the Word file to search"
      },
      "search_term": {
        "type": "string",
        "description": "Text to search for (case-insensitive)"
      }
    },
    "required": ["filename", "search_term"],
    "examples": [{"filename": "report.docx", "search_term": "revenue"}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "filename": {"type": "string"},
      "search_term": {"type": "string"},
      "matches": {
        "type": "array",
        "description": "Paragraphs containing the search term",
        "items": {
          "type": "object",
          "properties": {
            "paragraph_index": {"type": "integer"},
            "text": {"type": "string"}
          }
        }
      },
      "match_count": {"type": "integer"}
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Document Processing",
    "tags": ["word", "search", "find", "text"],
    "rateLimit": 60,
    "cacheTTL": 300,
    "examples": [
      {
        "description": "Search for 'revenue' in annual report",
        "input": {
          "filename": "annual_report.docx",
          "search_term": "revenue"
        }
      }
    ],
    "useCases": [
      "Find specific content in documents",
      "Keyword search in Word files",
      "Document content analysis"
    ]
  }
}
