{
  "name": "msdoc_get_word_metadata",
  "implementation": "sajha.tools.impl.msdoc_tools_tool_refactored.MsDocGetWordMetadataTool",
  "description": "Core document properties of a Word file (.docx). Files are looked up by name in the docs folder (data/msdocs; msdoc_list_files shows it). Needs the python-docx package (optional in requirements.txt).\nReturns {filename, metadata}: metadata has author, title, subject, created and modified (empty strings when unset).\nInputs (* required): filename*.\nFor content use msdoc_read_word; for Excel files msdoc_get_excel_metadata.\nExample: {\"filename\": \"report.docx\"}",
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "filename": {
        "type": "string",
        "description": "Name of the Word file"
      }
    },
    "required": ["filename"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "filename": {"type": "string"},
      "metadata": {
        "type": "object",
        "description": "Document metadata",
        "properties": {
          "author": {"type": "string"},
          "title": {"type": "string"},
          "subject": {"type": "string"},
          "created": {"type": "string"},
          "modified": {"type": "string"}
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Document Processing",
    "tags": ["word", "metadata", "properties"],
    "rateLimit": 60,
    "cacheTTL": 3600,
    "examples": [
      {
        "description": "Get Word document metadata",
        "input": {"filename": "contract.docx"}
      }
    ],
    "useCases": [
      "Document provenance tracking",
      "Metadata extraction",
      "Document property analysis"
    ]
  }
}
