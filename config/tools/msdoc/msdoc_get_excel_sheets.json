{
  "name": "msdoc_get_excel_sheets",
  "implementation": "sajha.tools.impl.msdoc_tools_tool_refactored.MsDocGetExcelSheetsTool",
  "description": "Lists the worksheets of an Excel workbook (.xlsx/.xlsm) in order. Files are looked up by name in the docs folder (data/msdocs; msdoc_list_files shows it).\nReturns {filename, sheets, count}: each sheet is {index (0-based), name}.\nInputs (* required): filename*.\nThen read a sheet with msdoc_read_excel_sheet or msdoc_read_excel.\nExample: {\"filename\": \"sales.xlsx\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": false},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "filename": {
        "type": "string",
        "description": "Name of the Excel file"
      }
    },
    "required": ["filename"],
    "examples": [{"filename": "sales.xlsx"}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "filename": {"type": "string"},
      "sheets": {
        "type": "array",
        "description": "List of worksheets",
        "items": {
          "type": "object",
          "properties": {
            "index": {"type": "integer", "description": "0-based sheet index"},
            "name": {"type": "string", "description": "Sheet name"}
          }
        }
      },
      "count": {"type": "integer", "description": "Total number of sheets"}
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Document Processing",
    "tags": ["excel", "worksheets", "sheets", "list"],
    "rateLimit": 60,
    "cacheTTL": 3600,
    "examples": [
      {
        "description": "List all sheets in workbook",
        "input": {"filename": "quarterly_report.xlsx"}
      }
    ],
    "useCases": [
      "Discover workbook structure",
      "Sheet inventory",
      "Workbook navigation"
    ]
  }
}
