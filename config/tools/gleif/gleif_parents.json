{
  "name": "gleif_parents",
  "implementation": "sajha.tools.impl.gleif_tools.GleifParentsTool",
  "description": "An entity's direct and ultimate accounting-consolidation parents. Each is reported (the parent), a reporting_exception (with the reason, e.g. NATURAL_PERSONS) or not_applicable; none is an error.\nReturns: lei, legal_name, direct_parent, ultimate_parent ({status, parent or exception}), source.\nInputs (* required): lei*.\nExample: {\"lei\": \"529900SS7ZWCX82U3W60\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "lei": {
        "type": "string",
        "description": "LEI, 20 characters",
        "pattern": "^[A-Za-z0-9]{18}[0-9]{2}$"
      }
    },
    "required": [
      "lei"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "lei": "529900SS7ZWCX82U3W60"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "lei",
      "direct_parent",
      "ultimate_parent",
      "source"
    ],
    "properties": {
      "lei": {
        "type": "string",
        "description": "The entity"
      },
      "legal_name": {
        "type": [
          "string",
          "null"
        ],
        "description": "Its legal name"
      },
      "direct_parent": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "reported, reporting_exception or not_applicable",
            "enum": [
              "reported",
              "reporting_exception",
              "not_applicable"
            ]
          },
          "parent": {
            "type": "object",
            "properties": {
              "lei": {
                "type": "string",
                "description": "Legal entity identifier"
              },
              "legal_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Legal name"
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Country of the legal address (ISO 3166 alpha-2)"
              },
              "jurisdiction": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Legal jurisdiction (ISO 3166 code)"
              },
              "entity_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ACTIVE or INACTIVE"
              },
              "registration_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ISSUED, LAPSED, RETIRED, ..."
              }
            }
          },
          "exception": {
            "type": "object",
            "properties": {
              "category": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which parent the exception is for"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "NATURAL_PERSONS, NON_CONSOLIDATING, NO_KNOWN_PERSON, NON_PUBLIC, ..."
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional reference"
              }
            }
          }
        }
      },
      "ultimate_parent": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "reported, reporting_exception or not_applicable",
            "enum": [
              "reported",
              "reporting_exception",
              "not_applicable"
            ]
          },
          "parent": {
            "type": "object",
            "properties": {
              "lei": {
                "type": "string",
                "description": "Legal entity identifier"
              },
              "legal_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Legal name"
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Country of the legal address (ISO 3166 alpha-2)"
              },
              "jurisdiction": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Legal jurisdiction (ISO 3166 code)"
              },
              "entity_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ACTIVE or INACTIVE"
              },
              "registration_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ISSUED, LAPSED, RETIRED, ..."
              }
            }
          },
          "exception": {
            "type": "object",
            "properties": {
              "category": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which parent the exception is for"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "NATURAL_PERSONS, NON_CONSOLIDATING, NO_KNOWN_PERSON, NON_PUBLIC, ..."
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional reference"
              }
            }
          }
        }
      },
      "source": {
        "type": "string",
        "description": "Attribution line; cite it with the data"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Reference Data",
    "tags": [
      "lei",
      "gleif",
      "hierarchy",
      "parent"
    ]
  }
}
