{
  "name": "oecd_quarterly_national_accounts",
  "implementation": "sajha.tools.impl.oecd_tools.OecdQuarterlyNationalAccountsTool",
  "description": "OECD quarterly national accounts (DF_QNA), seasonally adjusted: GDP or a component, as real growth (percent), volume or current prices.\nReturns: dataflow, key, source, series (country, unit, unit_multiplier, observations date/value).\nInputs (* required): countries*, transaction (default gdp), measure (growth_qoq, growth_yoy, volume, current_prices), period (default last 3 years).\nExample: {\"countries\": [\"USA\", \"DEU\", \"JPN\"], \"transaction\": \"gdp\", \"measure\": \"growth_qoq\", \"period\": \"last 3 years\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 43200,
  "inputSchema": {
    "type": "object",
    "properties": {
      "countries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "maxItems": 40,
        "description": "ISO 3166 alpha-3 or alpha-2 codes, names, or OECD, G20, G7, EA20"
      },
      "transaction": {
        "type": "string",
        "enum": [
          "gdp",
          "household_consumption",
          "government_consumption",
          "gross_fixed_capital_formation",
          "exports",
          "imports"
        ],
        "default": "gdp",
        "description": "GDP or an expenditure component"
      },
      "measure": {
        "type": "string",
        "enum": [
          "growth_qoq",
          "growth_yoy",
          "volume",
          "current_prices"
        ],
        "default": "growth_qoq",
        "description": "growth_qoq, growth_yoy (percent, chain-linked volume), volume or current_prices (national currency)"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 3 years"
      }
    },
    "required": [
      "countries"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "countries": [
          "USA",
          "DEU",
          "JPN"
        ],
        "transaction": "gdp",
        "measure": "growth_qoq",
        "period": "last 3 years"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "OECD dataflow (AGENCY,ID)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: OECD ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, what was cut, or what is projected"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "OECD area code (alpha-3 or aggregate)"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Percent per year, Index)"
            },
            "unit_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "OECD unit code"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions, billions or null"
            },
            "base_period": {
              "type": [
                "string",
                "null"
              ],
              "description": "Index base or reference year, when any"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly, Quarterly, Annual"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "oecd",
      "gdp",
      "national accounts",
      "growth"
    ]
  }
}
