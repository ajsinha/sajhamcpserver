{
  "name": "oecd_economic_outlook",
  "implementation": "sajha.tools.impl.oecd_tools.OecdEconomicOutlookTool",
  "description": "OECD Economic Outlook, the latest edition (DF_EO), annual history and projections: growth, inflation, unemployment, fiscal balance, debt, current account, rates.\nReturns: dataflow, key, source, note, series (country, indicator, unit, observations date/value/projection).\nInputs (* required): countries*, indicators (default gdp_growth, inflation, unemployment_rate), period (default last 5 years; the projection years follow).\nExample: {\"countries\": [\"USA\", \"DEU\", \"OECD\"], \"indicators\": [\"gdp_growth\", \"inflation\"], \"period\": \"last 5 years\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 43200,
  "inputSchema": {
    "type": "object",
    "properties": {
      "countries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "maxItems": 40,
        "description": "ISO 3166 alpha-3 or alpha-2 codes, names, or OECD, G20, G7, EA20"
      },
      "indicators": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "gdp_growth",
            "inflation",
            "core_inflation",
            "unemployment_rate",
            "fiscal_balance",
            "government_debt",
            "current_account",
            "short_term_rate",
            "long_term_rate"
          ]
        },
        "minItems": 1,
        "default": [
          "gdp_growth",
          "inflation",
          "unemployment_rate"
        ],
        "description": "gdp_growth, inflation, core_inflation (percent), unemployment_rate, fiscal_balance, government_debt, current_account (percent of GDP), short_term_rate, long_term_rate"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 5 years"
      }
    },
    "required": [
      "countries"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "countries": [
          "USA",
          "DEU",
          "OECD"
        ],
        "indicators": [
          "gdp_growth",
          "inflation"
        ],
        "period": "last 5 years"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "OECD dataflow (AGENCY,ID)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: OECD ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, what was cut, or what is projected"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "OECD area code (alpha-3 or aggregate)"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Percent per year, Index)"
            },
            "unit_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "OECD unit code"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions, billions or null"
            },
            "base_period": {
              "type": [
                "string",
                "null"
              ],
              "description": "Index base or reference year, when any"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly, Quarterly, Annual"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  },
                  "projection": {
                    "type": "boolean",
                    "description": "True for a projection (the current year on)"
                  }
                }
              }
            },
            "indicator": {
              "type": [
                "string",
                "null"
              ],
              "description": "The indicator name asked for"
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "oecd",
      "economic outlook",
      "projections",
      "forecasts"
    ]
  }
}
