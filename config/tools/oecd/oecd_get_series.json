{
  "name": "oecd_get_series",
  "implementation": "sajha.tools.impl.oecd_tools.OecdGetSeriesTool",
  "description": "Any OECD dataflow and key (the escape hatch): dimension codes joined by dots, + for several, empty for all. Find dataflows with oecd_search.\nReturns: dataflow, key, source, series (country, unit, dimensions, observations date/value).\nInputs (* required): dataflow* (AGENCY,ID or a unique id), key*, period (default last 3 years), max_series (default 20).\nExample: {\"dataflow\": \"OECD.SDD.STES,DSD_STES@DF_CLI\", \"key\": \"USA.M.LI.IX._Z.AA.IX._Z.H\", \"period\": \"last 12 months\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 43200,
  "inputSchema": {
    "type": "object",
    "properties": {
      "dataflow": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120,
        "description": "AGENCY,ID[,VERSION] (e.g. OECD.SDD.STES,DSD_STES@DF_FINMARK) or a unique id"
      },
      "key": {
        "type": "string",
        "maxLength": 300,
        "description": "Dimension codes in key order joined by dots; + for several codes; empty for all"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 3 years"
      },
      "max_series": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "Most series returned"
      }
    },
    "required": [
      "dataflow",
      "key"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "dataflow": "OECD.SDD.STES,DSD_STES@DF_CLI",
        "key": "USA.M.LI.IX._Z.AA.IX._Z.H",
        "period": "last 12 months"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "OECD dataflow (AGENCY,ID)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: OECD ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, what was cut, or what is projected"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "OECD area code (alpha-3 or aggregate)"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unit (e.g. Percent per year, Index)"
            },
            "unit_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "OECD unit code"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions, billions or null"
            },
            "base_period": {
              "type": [
                "string",
                "null"
              ],
              "description": "Index base or reference year, when any"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly, Quarterly, Annual"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM, YYYY-Qn or YYYY"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "oecd",
      "sdmx",
      "statistics"
    ]
  }
}
