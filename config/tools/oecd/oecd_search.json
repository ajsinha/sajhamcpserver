{
  "name": "oecd_search",
  "implementation": "sajha.tools.impl.oecd_tools.OecdSearchTool",
  "description": "Find OECD dataflows by words in their name or id (the dataflow list, cached for a day).\nReturns: text, source, count, dataflows (dataflow as AGENCY,ID, name, version).\nInputs (* required): text*, limit (default 20).\nExample: {\"text\": \"consumer price\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 86400,
  "inputSchema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "description": "Words that must all appear in the name or id"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "Most dataflows returned"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "text": "consumer price"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "dataflows"
    ],
    "properties": {
      "text": {
        "type": "string",
        "description": "The words searched for"
      },
      "source": {
        "type": "string",
        "description": "Source: OECD ..."
      },
      "count": {
        "type": "integer",
        "description": "Dataflows matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why nothing matched"
      },
      "dataflows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "dataflow": {
              "type": "string",
              "description": "AGENCY,ID for oecd_get_series"
            },
            "name": {
              "type": "string",
              "description": "Dataflow name"
            },
            "version": {
              "type": "string",
              "description": "Dataflow version"
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "oecd",
      "search",
      "catalogue"
    ]
  }
}
