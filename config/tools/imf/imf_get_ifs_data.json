{
  "name": "imf_get_ifs_data",
  "implementation": "sajha.tools.impl.imf_tool_refactored.IMFGetIFSDataTool",
  "description": "A monetary or price indicator of the IMF's retired International Financial Statistics, read from its successor dataflow: exchange_rate / exchange_rate_avg (national currency per USD, end of period / average; ER), policy_rate, treasury_bill_yield, deposit_rate, lending_rate, money_market_rate (% a year; MFS_IR), cpi (index) and cpi_inflation (% on a year earlier; CPI), international_reserves (USD, gold at market value; IL), broad_money (national currency; MFS_MA). Some countries report no MFS_IR or MFS_MA data.\nReturns: database, key, country_code, indicator or indicator_code, frequency, name, data (period, value) oldest first, count, source; a note when empty.\nInputs (* required): country_code* (ISO3 or ISO2); indicator* (one of the names above); frequency (A, Q, M; default M); start_year, end_year.\nExample: {\"country_code\": \"IND\", \"indicator\": \"cpi_inflation\", \"start_year\": 2025}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "country_code": {
        "type": "string",
        "description": "Country: ISO alpha-3 (USA) or alpha-2 (US); IMF group codes such as G001 (world) pass through"
      },
      "indicator": {
        "type": "string",
        "enum": [
          "exchange_rate",
          "exchange_rate_avg",
          "policy_rate",
          "treasury_bill_yield",
          "deposit_rate",
          "lending_rate",
          "money_market_rate",
          "cpi",
          "cpi_inflation",
          "international_reserves",
          "broad_money"
        ],
        "description": "Indicator"
      },
      "frequency": {
        "type": "string",
        "enum": [
          "A",
          "Q",
          "M"
        ],
        "default": "M",
        "description": "A annual, Q quarterly, M monthly"
      },
      "start_year": {
        "type": "integer",
        "minimum": 1950,
        "maximum": 2035,
        "description": "First year (optional)"
      },
      "end_year": {
        "type": "integer",
        "minimum": 1950,
        "maximum": 2035,
        "description": "Last year (optional)"
      }
    },
    "required": [
      "country_code",
      "indicator"
    ],
    "examples": [{"country_code": "IND", "indicator": "cpi_inflation", "start_year": 2025}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "database": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "country_code": {
        "type": "string"
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "latest_actual_year": {
        "type": "string"
      },
      "data": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      },
      "count": {
        "type": "integer"
      },
      "source": {
        "type": "string"
      },
      "note": {
        "type": "string"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "imf",
      "ifs",
      "financial statistics",
      "exchange rates",
      "interest rates"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "International Financial Statistics provides comprehensive financial and monetary data.",
    "examples": [
      {
        "description": "India CPI inflation",
        "input": {
          "country_code": "IND",
          "indicator": "cpi_inflation",
          "start_year": 2025
        }
      },
      {
        "description": "Brazil policy rate",
        "input": {
          "country_code": "BR",
          "indicator": "policy_rate",
          "start_year": 2024
        }
      }
    ],
    "useCases": [
      "Exchange rate analysis",
      "Interest rate tracking",
      "Inflation monitoring",
      "Monetary policy research",
      "Reserve analysis"
    ]
  }
}
