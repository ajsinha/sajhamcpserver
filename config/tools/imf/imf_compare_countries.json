{
  "name": "imf_compare_countries",
  "implementation": "sajha.tools.impl.imf_tool_refactored.IMFCompareCountriesTool",
  "description": "One IMF indicator for two or more countries, fetched in one request: a WEO indicator (annual, with projections) or a former-IFS indicator from its successor dataflow.\nReturns: database, key, frequency and countries (country_code, country_name, name, data (period, value), count; a note for a country with no data), source.\nInputs (* required): country_codes* (2-20 ISO3 or ISO2 codes); database (WEO or IFS; default WEO); indicator (WEO: gdp_growth, gdp_usd, gdp_per_capita, inflation_avg, inflation_eop, unemployment, ...; IFS: names as in imf_get_ifs_data) or, for WEO, indicator_code; frequency (A, Q, M; IFS only; default A); start_year, end_year.\nExample: {\"country_codes\": [\"USA\", \"DEU\", \"JPN\"], \"indicator\": \"gdp_growth\", \"start_year\": 2022}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "country_codes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 20,
        "description": "ISO alpha-3 or alpha-2 country codes"
      },
      "database": {
        "type": "string",
        "enum": [
          "WEO",
          "IFS"
        ],
        "default": "WEO",
        "description": "WEO indicators or former IFS indicators"
      },
      "indicator": {
        "type": "string",
        "enum": [
          "gdp_growth",
          "gdp_usd",
          "gdp_per_capita",
          "inflation_avg",
          "inflation_eop",
          "unemployment",
          "current_account",
          "fiscal_balance",
          "public_debt",
          "exports_volume",
          "imports_volume",
          "population",
          "exchange_rate",
          "exchange_rate_avg",
          "policy_rate",
          "treasury_bill_yield",
          "deposit_rate",
          "lending_rate",
          "money_market_rate",
          "cpi",
          "cpi_inflation",
          "international_reserves",
          "broad_money"
        ],
        "description": "Friendly indicator name (WEO or IFS list)"
      },
      "indicator_code": {
        "type": "string",
        "description": "WEO indicator code (WEO only)"
      },
      "frequency": {
        "type": "string",
        "enum": [
          "A",
          "Q",
          "M"
        ],
        "default": "A",
        "description": "IFS only"
      },
      "start_year": {
        "type": "integer",
        "minimum": 1950,
        "maximum": 2035,
        "description": "First year (optional)"
      },
      "end_year": {
        "type": "integer",
        "minimum": 1950,
        "maximum": 2035,
        "description": "Last year (optional)"
      }
    },
    "required": [
      "country_codes"
    ],
    "examples": [{"country_codes": ["USA", "DEU", "JPN"], "indicator": "gdp_growth", "start_year": 2022}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "database": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "frequency": {
        "type": "string"
      },
      "countries": {
        "type": "array"
      },
      "source": {
        "type": "string"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "imf",
      "comparison",
      "cross-country",
      "benchmarking"
    ],
    "rateLimit": 100,
    "cacheTTL": 3600,
    "note": "Compare economic indicators across countries for benchmarking and analysis.",
    "examples": [
      {
        "description": "GDP growth, three economies",
        "input": {
          "country_codes": [
            "USA",
            "DEU",
            "JPN"
          ],
          "indicator": "gdp_growth",
          "start_year": 2022
        }
      },
      {
        "description": "CPI inflation, monthly",
        "input": {
          "country_codes": [
            "GBR",
            "FRA"
          ],
          "database": "IFS",
          "indicator": "cpi_inflation",
          "frequency": "M",
          "start_year": 2026
        }
      }
    ],
    "useCases": [
      "Cross-country analysis",
      "Benchmarking",
      "Regional comparisons",
      "Policy evaluation",
      "Investment research"
    ]
  }
}
