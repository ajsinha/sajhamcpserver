{
  "name": "sanctions_changes",
  "implementation": "sajha.tools.impl.sanctions_tools.SanctionsChangesTool",
  "description": "Entries added to, changed on and removed from the official sanctions lists between the local index's refreshes since a date.\nReturns {since, list, refreshes: [{list, refreshed_at, publication_date, previous_publication_date, initial, added_count, changed_count, removed_count}], added, changed, removed (each [{list, refreshed_at, entry_id, name}], newest 1000), truncated, notice, source}.\nInputs (* required): since* (YYYY-MM-DD), list (default all).\nExample: {\"since\": \"2026-10-01\"}\nA list's first download is marked initial and lists no entries.",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "since": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Refreshes on or after this date (YYYY-MM-DD)",
        "examples": [
          "2026-10-01"
        ]
      },
      "list": {
        "type": "string",
        "enum": [
          "ofac_sdn",
          "ofac_consolidated",
          "eu",
          "uk",
          "un"
        ],
        "description": "One list; default every list"
      }
    },
    "required": [
      "since"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "since": "2026-10-01"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "since": {
        "type": "string"
      },
      "list": {
        "type": [
          "string",
          "null"
        ]
      },
      "refreshes": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "added": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string"
            },
            "refreshed_at": {
              "type": "string"
            },
            "entry_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      },
      "changed": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string"
            },
            "refreshed_at": {
              "type": "string"
            },
            "entry_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      },
      "removed": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string"
            },
            "refreshed_at": {
              "type": "string"
            },
            "entry_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "notice": {
        "type": "string",
        "description": "Screening aid, not a determination"
      },
      "source": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Attribution line of each list in the result"
      }
    },
    "required": [
      "since",
      "refreshes",
      "added",
      "changed",
      "removed",
      "notice"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Sanctions",
    "tags": [
      "sanctions",
      "changes",
      "delta"
    ],
    "examples": [
      {
        "description": "Changes this month",
        "input": {
          "since": "2026-10-01"
        }
      },
      {
        "description": "EU changes only",
        "input": {
          "since": "2026-10-01",
          "list": "eu"
        }
      }
    ]
  }
}