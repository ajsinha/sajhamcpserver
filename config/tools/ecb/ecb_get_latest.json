{
  "name": "ecb_get_latest",
  "implementation": "sajha.tools.impl.european_central_bank_tool_refactored.ECBGetLatestTool",
  "description": "The most recent observation of one ECB series, by dataflow and key or shorthand indicator. It asks the ECB for the series' last observation (lastNObservations=1), so it works for daily, monthly and quarterly series alike.\nReturns: flow, key, series_name, description, date and value; an error when the series has no data.\nInputs: flow and key together (e.g. FM and B.U2.EUR.4F.KR.DFR.LEV) or indicator (eur_usd, eur_gbp, eur_jpy, eur_cny, eur_chf, main_refinancing_rate, deposit_facility_rate, marginal_lending_rate, ester, bond_2y/5y/10y, hicp_overall/core/energy, gdp, m1, m2, m3, unemployment_rate); one form is needed.\nFor several headline values at once use ecb_get_common_indicators.\nExample: {\"indicator\": \"hicp_overall\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "flow": {
        "type": "string",
        "description": "ECB data flow identifier (e.g., 'EXR', 'FM', 'HICP')"
      },
      "key": {
        "type": "string",
        "description": "ECB series key"
      },
      "indicator": {
        "type": "string",
        "description": "Common indicator shorthand",
        "enum": [
          "eur_usd", "eur_gbp", "eur_jpy", "eur_cny", "eur_chf",
          "main_refinancing_rate", "deposit_facility_rate", "marginal_lending_rate", "ester",
          "bond_2y", "bond_5y", "bond_10y",
          "hicp_overall", "hicp_core", "hicp_energy",
          "gdp", "m1", "m2", "m3", "unemployment_rate"
        ]
      }
    },
    "oneOf": [
      {"required": ["flow", "key"]},
      {"required": ["indicator"]}
    ],
    "examples": [{"indicator": "hicp_overall"}]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "flow": {
        "type": "string",
        "description": "ECB data flow identifier"
      },
      "key": {
        "type": "string",
        "description": "ECB series key"
      },
      "series_name": {
        "type": "string",
        "description": "Series identifier"
      },
      "description": {
        "type": "string",
        "description": "Series description"
      },
      "date": {
        "type": "string",
        "description": "Date of the latest observation"
      },
      "value": {
        "type": ["number", "null"],
        "description": "Latest observation value"
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": ["current", "latest", "real-time", "ecb", "eurozone", "snapshot"],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Optimized for dashboard and real-time displays. Returns only the most recent value with minimal payload size.",
    "examples": [
      {
        "description": "Get current EUR/USD exchange rate",
        "input": {
          "indicator": "eur_usd"
        }
      },
      {
        "description": "Get current ECB main refinancing rate",
        "input": {
          "indicator": "main_refinancing_rate"
        }
      },
      {
        "description": "Get latest HICP overall inflation",
        "input": {
          "flow": "HICP",
          "key": "M.U2.N.000000.4D0.ANR"
        }
      }
    ],
    "useCases": [
      "Real-time dashboards",
      "Economic indicator displays",
      "Trading terminals",
      "Mobile apps (reduced data)",
      "Status checks",
      "Alerting systems"
    ],
    "performanceNotes": {
      "responseSize": "~200 bytes (vs ~2KB for time series)",
      "apiCalls": "1 per request",
      "cacheRecommendation": "Cache for 1 hour for non-critical use cases"
    }
  }
}
