{
  "name": "abs_labour_force",
  "implementation": "sajha.tools.impl.abs_tools.AbsLabourForceTool",
  "description": "Australian Labour Force survey, monthly (ABS LF): unemployment, participation and underemployment rates in percent, employed and unemployed persons in thousands.\nReturns: dataflow, key, source, series (region, measure, unit, adjustment, observations date/value).\nInputs (* required): measures (default unemployment_rate), sex (persons, males, females), region (australia or a state, e.g. nsw), adjustment (default seasonally_adjusted), period.\nExample: {\"measures\": [\"unemployment_rate\", \"participation_rate\"], \"period\": \"last 12 months\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "measures": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "unemployment_rate",
            "employed",
            "unemployed",
            "participation_rate",
            "employment_to_population",
            "underemployment_rate",
            "underutilisation_rate",
            "labour_force"
          ]
        },
        "minItems": 1,
        "default": [
          "unemployment_rate"
        ],
        "description": "Rates in percent; counts in thousands of persons"
      },
      "sex": {
        "type": "string",
        "enum": [
          "persons",
          "males",
          "females"
        ],
        "default": "persons",
        "description": "Sex"
      },
      "region": {
        "type": "string",
        "default": "australia",
        "description": "australia, or a state or territory: nsw, vic, qld, sa, wa, tas, nt, act"
      },
      "adjustment": {
        "type": "string",
        "enum": [
          "original",
          "seasonally_adjusted",
          "trend"
        ],
        "description": "Time series adjustment",
        "default": "seasonally_adjusted"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 12 months"
      }
    },
    "additionalProperties": false,
    "examples": [
      {
        "measures": [
          "unemployment_rate",
          "participation_rate"
        ],
        "period": "last 12 months"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "ABS dataflow (ABS,ID)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: Australian Bureau of Statistics ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "region": {
              "type": [
                "string",
                "null"
              ],
              "description": "Region (a name for the CPI capital cities, else the ABS code)"
            },
            "measure": {
              "type": "string",
              "description": "The measure asked for"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Index, Percent, Number or Australian dollars"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions or null"
            },
            "adjustment": {
              "type": [
                "string",
                "null"
              ],
              "description": "original, seasonally_adjusted or trend"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly or Quarterly"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM or YYYY-Qn"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit and multiplier"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "abs",
      "australia",
      "labour market",
      "unemployment",
      "employment"
    ]
  }
}
