{
  "name": "abs_get_series",
  "implementation": "sajha.tools.impl.abs_tools.AbsGetSeriesTool",
  "description": "Any ABS dataflow and key (the escape hatch): dimension codes joined by dots, + for several, empty for all. Keep queries small (30 s, 10 MB).\nReturns: dataflow, key, source, series (region, unit, dimensions, observations date/value).\nInputs (* required): dataflow* (e.g. CPI, LF, WPI, ANA_EXP), key*, period (default last 3 years), max_series (default 20).\nExample: {\"dataflow\": \"WPI\", \"key\": \"3.THRPEB.7.TOT.20.AUS.Q\", \"period\": \"last 3 years\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "dataflow": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "description": "ABS dataflow id (CPI, LF, WPI, ANA_EXP, RES_DWELL ...) or ABS,ID,VERSION"
      },
      "key": {
        "type": "string",
        "maxLength": 300,
        "description": "Dimension codes in key order joined by dots; + for several; empty for all"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 3 years"
      },
      "max_series": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "Most series returned"
      }
    },
    "required": [
      "dataflow",
      "key"
    ],
    "additionalProperties": false,
    "examples": [
      {
        "dataflow": "WPI",
        "key": "3.THRPEB.7.TOT.20.AUS.Q",
        "period": "last 3 years"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "ABS dataflow (ABS,ID)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: Australian Bureau of Statistics ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "region": {
              "type": [
                "string",
                "null"
              ],
              "description": "Region (a name for the CPI capital cities, else the ABS code)"
            },
            "measure": {
              "type": "string",
              "description": "The measure asked for"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Index, Percent, Number or Australian dollars"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions or null"
            },
            "adjustment": {
              "type": [
                "string",
                "null"
              ],
              "description": "original, seasonally_adjusted or trend"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly or Quarterly"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM or YYYY-Qn"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit and multiplier"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "abs",
      "australia",
      "sdmx",
      "statistics"
    ]
  }
}
