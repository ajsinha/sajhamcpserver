{
  "name": "abs_cpi",
  "implementation": "sajha.tools.impl.abs_tools.AbsCpiTool",
  "description": "Australian consumer price index (ABS CPI): annual or period change in percent, or the index, for Australia or the capital cities.\nReturns: dataflow, key, source, series (region, measure, unit, adjustment, observations date/value).\nInputs (* required): measure (annual_change, period_change, index; default annual_change), item (CPI INDEX code, default 10001 All groups), regions, adjustment, frequency (monthly, quarterly), period.\nExample: {\"measure\": \"annual_change\", \"regions\": [\"australia\"], \"period\": \"last 12 months\"}",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "version": "1.0.0",
  "enabled": true,
  "cache_ttl": 21600,
  "inputSchema": {
    "type": "object",
    "properties": {
      "measure": {
        "type": "string",
        "enum": [
          "annual_change",
          "period_change",
          "index"
        ],
        "default": "annual_change",
        "description": "annual_change, period_change (percent) or index"
      },
      "item": {
        "type": "string",
        "pattern": "^[0-9]{3,7}$",
        "default": "10001",
        "description": "CPI INDEX code: 10001 All groups, 20001 Food, 999901 All groups excluding volatile items ..."
      },
      "regions": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "australia",
            "sydney",
            "melbourne",
            "brisbane",
            "adelaide",
            "perth",
            "hobart",
            "darwin",
            "canberra"
          ]
        },
        "minItems": 1,
        "default": [
          "australia"
        ],
        "description": "Australia (weighted average of eight capital cities) or capital cities"
      },
      "adjustment": {
        "type": "string",
        "enum": [
          "original",
          "seasonally_adjusted",
          "trend"
        ],
        "description": "Time series adjustment",
        "default": "original"
      },
      "frequency": {
        "type": "string",
        "enum": [
          "monthly",
          "quarterly"
        ],
        "default": "monthly",
        "description": "monthly or quarterly"
      },
      "period": {
        "type": "string",
        "description": "latest, 'last N months|quarters|years', 2025, 2025-Q3, 2025-07, or A/B",
        "default": "last 12 months"
      }
    },
    "additionalProperties": false,
    "examples": [
      {
        "measure": "annual_change",
        "regions": [
          "australia"
        ],
        "period": "last 12 months"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "source",
      "series"
    ],
    "properties": {
      "dataflow": {
        "type": "string",
        "description": "ABS dataflow (ABS,ID)"
      },
      "key": {
        "type": "string",
        "description": "SDMX series key asked for"
      },
      "period": {
        "type": [
          "string",
          "null"
        ],
        "description": "The period asked for"
      },
      "source": {
        "type": "string",
        "description": "Source: Australian Bureau of Statistics ...; cite it with the data"
      },
      "series_count": {
        "type": "integer",
        "description": "Series matched"
      },
      "truncated": {
        "type": "boolean",
        "description": "More series matched than were returned"
      },
      "note": {
        "type": "string",
        "description": "Why there is no data, or what was cut"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Series key"
            },
            "region": {
              "type": [
                "string",
                "null"
              ],
              "description": "Region (a name for the CPI capital cities, else the ABS code)"
            },
            "measure": {
              "type": "string",
              "description": "The measure asked for"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Index, Percent, Number or Australian dollars"
            },
            "unit_multiplier": {
              "type": [
                "string",
                "null"
              ],
              "description": "thousands, millions or null"
            },
            "adjustment": {
              "type": [
                "string",
                "null"
              ],
              "description": "original, seasonally_adjusted or trend"
            },
            "frequency": {
              "type": [
                "string",
                "null"
              ],
              "description": "Monthly or Quarterly"
            },
            "dimensions": {
              "type": "object",
              "description": "The series key by dimension"
            },
            "observation_count": {
              "type": "integer",
              "description": "Observations returned"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Period: YYYY-MM or YYYY-Qn"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Value in the series unit and multiplier"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "abs",
      "australia",
      "inflation",
      "cpi",
      "prices"
    ]
  }
}
