{
  "name": "boc_get_bond_yield",
  "implementation": "sajha.tools.impl.bank_of_canada_tool_refactored.BoCGetBondYieldTool",
  "description": "Government of Canada benchmark bond yields in percent for the 2, 5 and 10 year maturities or the long-term benchmark bond, from the Bank of Canada Valet API (no API key).\nReturns: series_name, label, description, dimension, observation_count and observations (date, value) oldest first.\nInputs (none required): bond_term (2y, 5y, 10y, or 30y for the long-term benchmark bond; default 10y); start_date, end_date (YYYY-MM-DD; either or both); recent_periods (1-100; default 10; the last N observations, used only when no date is given).\nFor policy and overnight rates use boc_get_interest_rate; for US Treasuries fed_get_series with treasury_10y or treasury_2y.\nExample: {\"bond_term\": \"5y\", \"start_date\": \"2024-01-01\", \"end_date\": \"2024-06-30\"}",
  "annotations": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
  "version": "2.9.8",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "bond_term": {
        "type": "string",
        "description": "Bond maturity term (30y is the Government of Canada long-term benchmark bond)",
        "enum": [
          "2y",
          "5y",
          "10y",
          "30y"
        ],
        "default": "10y"
      },
      "start_date": {
        "type": "string",
        "description": "Start date in YYYY-MM-DD format"
      },
      "end_date": {
        "type": "string",
        "description": "End date in YYYY-MM-DD format"
      },
      "recent_periods": {
        "type": "integer",
        "description": "Number of recent observations (1-100)",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "series_name": {
        "type": "string",
        "description": "Bond yield series identifier (e.g., 'BD.CDN.10YR.DQ.YLD' for 10-year)"
      },
      "label": {
        "type": "string",
        "description": "Bond description (e.g., 'Benchmark bond yield, 10-year')"
      },
      "description": {
        "type": "string",
        "description": "Detailed bond information"
      },
      "dimension": {
        "type": "object",
        "description": "Yield units and frequency (percentage, daily)",
        "properties": {
          "key": {
            "type": "string",
            "description": "Dimension key (typically 'd' for daily)"
          },
          "name": {
            "type": "string",
            "description": "Dimension name (typically 'Date')"
          }
        }
      },
      "observation_count": {
        "type": "integer",
        "description": "Number of yield observations returned"
      },
      "observations": {
        "type": "array",
        "description": "Historical bond yield values",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Date of yield observation (YYYY-MM-DD format)"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Bond yield percentage (null if not available)"
            }
          },
          "required": [
            "date",
            "value"
          ]
        }
      }
    },
    "required": [
      "series_name",
      "label",
      "observations"
    ]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Economic Data",
    "tags": [
      "bonds",
      "yields",
      "government bonds",
      "canada",
      "fixed income",
      "treasuries"
    ],
    "rateLimit": 120,
    "cacheTTL": 3600,
    "note": "Government of Canada benchmark bond yields across the yield curve. Useful for fixed income analysis and monetary policy assessment.",
    "examples": [
      {
        "description": "Get latest 10-year bond yield",
        "input": {
          "bond_term": "10y",
          "recent_periods": 1
        }
      },
      {
        "description": "Get 5-year yield history for past year",
        "input": {
          "bond_term": "5y",
          "start_date": "2023-11-01",
          "end_date": "2024-10-31"
        }
      },
      {
        "description": "Compare recent 2-year vs long-term (30y) yields (call twice)",
        "input": {
          "bond_term": "2y",
          "recent_periods": 30
        }
      }
    ],
    "useCases": [
      "Yield curve analysis",
      "Fixed income trading",
      "Monetary policy research",
      "Investment portfolio management",
      "Economic forecasting"
    ]
  }
}
