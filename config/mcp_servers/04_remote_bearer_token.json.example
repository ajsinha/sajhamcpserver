{
  "_comment": "Hosted servers reached over Streamable HTTP with a static credential header. ${NAME} reads an environment variable; ${NAME:default} falls back to a default. A raw value also works (SAJHA shows a notice) but keep this file out of git if you do.",
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {"Authorization": "Bearer ${GITHUB_PAT}"}
    },
    "github_readonly": {
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {"Authorization": "Bearer ${GITHUB_PAT}"},
      "vendor": "github",
      "prefix": "github_ro",
      "_comment": "Same vendor, its own prefix: tools are published as github_ro__<tool>."
    },
    "vendor_api": {
      "type": "http",
      "url": "${VENDOR_MCP_URL:https://mcp.vendor.example/mcp}",
      "headers": {"X-API-Key": "${VENDOR_MCP_KEY}", "X-Team": "risk-analytics"}
    }
  }
}
