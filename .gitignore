# ============================================================================
# SAJHA MCP Server v3 — Git Ignore
# ============================================================================

# ── Database (SQLite files auto-created on startup, never checked in) ────
data/*.db
data/*.db-journal
data/*.db-wal
data/rag/
*.sqlite
*.sqlite3

# ── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log

# ── Temp ─────────────────────────────────────────────────────────────────
temp/
tmp/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
.venv/
venv/
env/

# ── IDE ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ── Environment (secrets) ───────────────────────────────────────────────
.env
.env.local
.env.production

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Alembic ──────────────────────────────────────────────────────────────
alembic/versions/*.pyc

# ── Test ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OAuth signing keys (generated on first run) ─────────────────────────
data/oauth/

# ── Server secrets: JWT + session secret (generated on first run, mode 0600) ──
data/secrets/

# ── Snapshots of users, API keys and tools (snapshots.dir; owner-only, may name users) ──
data/snapshots/

# ── LLM-tool spool: large in-flight payloads of running calls (ai.llm_tools.memory.spool) ──
data/spool/

# ── Retired demo credentials: users live in the database only (Roadmap N5) ──
config/users.json

# ── Persistent API keys: hashed records written by the server (config/apikeys.json.example is the format) ──
config/apikeys.json
