{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAJHA MCP Server chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annotations": {
          "type": "object"
        },
        "nginx": {
          "type": "boolean"
        },
        "bodySize": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "streamTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "streamAnnotations": {
          "type": "object"
        },
        "sessionAffinity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^(|https?://[^/]+/?)$"
        },
        "overrides": {
          "type": "object"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "envFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "forwardedAllowIps": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "properties": {
            "jwtSecret": {
              "type": "string",
              "minLength": 1
            },
            "sessionSecret": {
              "type": "string",
              "minLength": 1
            },
            "oauthSigningKey": {
              "type": "string",
              "minLength": 1
            },
            "metricsToken": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "providerKeys": {
      "type": "object",
      "properties": {
        "existingSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sqlite",
            "postgresql"
          ]
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            },
            "urlSecret": {
              "type": "string"
            },
            "urlKey": {
              "type": "string"
            },
            "schemaCheck": {
              "type": "string",
              "enum": [
                "strict",
                "warn"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "auto",
            "memory",
            "redis",
            "database"
          ]
        },
        "redis": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(|rediss?://.+)$"
            },
            "existingSecret": {
              "type": "string"
            },
            "urlKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "existingSecret": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "local",
            "s3",
            "azure",
            "gcs"
          ]
        },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "endpointUrl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "azure": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "accountUrl": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "gcs": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "credentialsSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadWriteOncePod",
                  "ReadOnlyMany"
                ]
              }
            },
            "size": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadWriteOncePod",
                  "ReadOnlyMany"
                ]
              }
            },
            "size": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "seedMode": {
              "type": "string",
              "enum": [
                "missing",
                "overwrite"
              ]
            }
          },
          "additionalProperties": false
        },
        "tmpSizeLimit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "subprocess",
            "bwrap",
            "nsjail",
            "docker",
            "auto"
          ]
        }
      },
      "additionalProperties": false
    },
    "playground": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "string",
          "enum": [
            "vendored",
            "cdn"
          ]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "string",
          "enum": [
            "token",
            "admin",
            "none"
          ]
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sajhanet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedNetworks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "nets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,15}$",
                "not": {
                  "anyOf": [
                    {
                      "pattern": "__"
                    },
                    {
                      "pattern": "_$"
                    }
                  ]
                }
              },
              "instanceName": {
                "type": "string",
                "pattern": "^$|^[a-z][a-z0-9-]{0,30}[a-z0-9]$",
                "not": {
                  "pattern": "--"
                }
              },
              "advertiseAddress": {
                "type": "string"
              },
              "founder": {
                "type": "boolean"
              },
              "seeds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^https?://"
                }
              },
              "identitySecret": {
                "type": "string"
              },
              "revocationList": {
                "type": "boolean"
              },
              "caKeySecret": {
                "type": "string"
              },
              "settings": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "namespaceSelectors": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "extraFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "egress": {
          "type": "object",
          "properties": {
            "dns": {
              "type": "boolean"
            },
            "internet": {
              "type": "boolean"
            },
            "internetPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "internetExcept": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "databaseTo": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "backend": {
                "const": "s3"
              }
            },
            "required": [
              "backend"
            ]
          }
        },
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "properties": {
              "s3": {
                "properties": {
                  "bucket": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "backend": {
                "const": "azure"
              }
            },
            "required": [
              "backend"
            ]
          }
        },
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "properties": {
              "azure": {
                "properties": {
                  "container": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "backend": {
                "const": "gcs"
              }
            },
            "required": [
              "backend"
            ]
          }
        },
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "properties": {
              "gcs": {
                "properties": {
                  "bucket": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
