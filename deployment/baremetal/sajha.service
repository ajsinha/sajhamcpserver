# SAJHA MCP Server — systemd Service File
# Copyright All rights Reserved 2025-2030, Ashutosh Sinha
#
# Install: sudo cp sajha.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable sajha
#          sudo systemctl start sajha
#
[Unit]
Description=SAJHA MCP Server
Documentation=https://github.com/ajsinha/sajhamcpserver
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sajha
Group=sajha
WorkingDirectory=/opt/sajha
ExecStart=/opt/sajha/venv/bin/python run_sajha_web.py
Restart=always
RestartSec=5
TimeoutStartSec=30

# Environment
Environment=SAJHA_SERVER_HOST=127.0.0.1
Environment=SAJHA_SERVER_PORT=3002
Environment=SAJHA_DB_TYPE=postgresql
Environment=SAJHA_DB_HOST=localhost
Environment=SAJHA_DB_PORT=5432
Environment=SAJHA_DB_NAME=sajha
Environment=SAJHA_STORAGE_BACKEND=local
EnvironmentFile=-/opt/sajha/.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Everything the server writes: the database and DuckDB files (data/), tool configs and
# scripts written by MCP Studio (config/), the Python modules Studio generates
# (sajha/tools/impl/), log files (logs/) and scratch files (temp/).
# ("-": a path that does not exist yet is skipped instead of failing the unit)
ReadWritePaths=/opt/sajha/data /opt/sajha/config /opt/sajha/sajha/tools/impl -/opt/sajha/logs -/opt/sajha/temp /tmp
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sajha

[Install]
WantedBy=multi-user.target
